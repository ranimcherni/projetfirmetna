<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminLayoutController">
    <left>
        <VBox prefWidth="240" styleClass="admin-sidebar" spacing="5">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 10 30 10;">
                    <children>
                        <ImageView fitHeight="30" preserveRatio="true">
                            <image>
                                <Image url="@../images/logo1.png" />
                            </image>
                        </ImageView>
                        <Label text="FIRMETNA ADMIN" styleClass="admin-sidebar-logo" />
                    </children>
                </HBox>

                <Button onAction="#showDashboard" styleClass="admin-sidebar-item" text="📊 Tableau de bord" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button onAction="#showUsers" styleClass="admin-sidebar-item" text="👥 Utilisateurs" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button styleClass="admin-sidebar-item" text="📦 Produits" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button styleClass="admin-sidebar-item" text="🛒 Commandes" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button styleClass="admin-sidebar-item" text="📅 Événements" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button styleClass="admin-sidebar-item" text="📍 Lieux" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                
                <MenuButton styleClass="admin-sidebar-item-dropdown" text="💬 Gestion Forum" maxWidth="Infinity" alignment="BASELINE_LEFT">
                    <items>
                        <MenuItem text="Sujets" />
                        <MenuItem text="Commentaires" />
                    </items>
                </MenuButton>

                <Button styleClass="admin-sidebar-item" text="❤ Donations (Offres)" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button styleClass="admin-sidebar-item" text="🤝 Donations (Demandes)" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button styleClass="admin-sidebar-item" text="🤝 Partenariats" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button styleClass="admin-sidebar-item" text="📄 Offres partenaires" maxWidth="Infinity" alignment="BASELINE_LEFT" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator styleClass="admin-sidebar-separator" />
                
                <Button onAction="#goToSite" styleClass="admin-sidebar-footer-item" text="🌐 Voir le site" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                <Button onAction="#handleLogout" styleClass="admin-sidebar-logout" text="🚪 Déconnexion" maxWidth="Infinity" alignment="BASELINE_LEFT" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #f8f9fa;">
            <children>
                <!-- Top Bar -->
                <HBox alignment="CENTER_LEFT" styleClass="admin-top-bar" prefHeight="60">
                    <padding>
                        <Insets left="20" right="20" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER_LEFT">
                            <Label text="FIRMETNA Administration" styleClass="admin-top-title" />
                            <Label text="Gestion complète de la plateforme" styleClass="admin-top-subtitle" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="15">
                            <children>
                                <VBox alignment="CENTER_RIGHT">
                                    <Label text="Admin" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                                    <Label text="Connecté" style="-fx-font-size: 11; -fx-text-fill: #27ae60;" />
                                </VBox>
                                <StackPane style="-fx-background-color: #dfe6e9; -fx-background-radius: 50; -fx-padding: 8;">
                                    <Label text="👤" style="-fx-font-size: 16;" />
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Dynamic Content Area -->
                <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
</BorderPane>
