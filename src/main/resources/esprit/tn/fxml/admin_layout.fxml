<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminLayoutController" stylesheets="@../css/style.css">
    <children>
        <BorderPane>
            <left>
                <VBox prefWidth="240" styleClass="admin-sidebar" spacing="5">
                    <padding>
                        <Insets top="20" right="10" bottom="20" left="10"/>
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 10 30 10;">
                            <children>
                                <ImageView fitHeight="45" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label text="Admin" styleClass="admin-sidebar-logo" />
                            </children>
                        </HBox>

                        <Button onAction="#showDashboard" styleClass="admin-sidebar-item" text="📊 Tableau de bord" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#showUsers" styleClass="admin-sidebar-item" text="👥 Utilisateurs" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#showProducts" styleClass="admin-sidebar-item" text="📦 Produits" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#showCommandes" styleClass="admin-sidebar-item" text="🛒 Commandes" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#showEvents" styleClass="admin-sidebar-item" text="📅 Événements" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#showLieux" styleClass="admin-sidebar-item" text="📍 Lieux" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        
                        <VBox spacing="2" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-padding: 5;">
                            <Label text="💬 GESTION FORUM" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 5 10;" maxWidth="Infinity" />
                            <Button onAction="#showForumPublications" styleClass="admin-sidebar-item" text="↳ Sujets" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                            <Button onAction="#showForumComments" styleClass="admin-sidebar-item" text="↳ Commentaires" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                            <Button onAction="#showForumStats" styleClass="admin-sidebar-item" text="↳ Statistiques" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        </VBox>

                        <Button onAction="#showDonationsOffres" styleClass="admin-sidebar-item" text="❤ Donations (Offres)" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#showDonationsDemandes" styleClass="admin-sidebar-item" text="🤝 Donations (Demandes)" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#showPartenariats" styleClass="admin-sidebar-item" text="🤝 Partenariats" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#showOffresPartenaires" styleClass="admin-sidebar-item" text="📄 Offres partenaires" maxWidth="Infinity" alignment="BASELINE_LEFT" />

                        <Region VBox.vgrow="ALWAYS" />

                        <Separator styleClass="admin-sidebar-separator" />
                        
                        <Button onAction="#goToSite" styleClass="admin-sidebar-footer-item" text="🌐 Voir le site" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                        <Button onAction="#handleLogout" styleClass="admin-sidebar-logout" text="🚪 Déconnexion" maxWidth="Infinity" alignment="BASELINE_LEFT" />
                    </children>
                </VBox>
            </left>

            <center>
                <VBox style="-fx-background-color: #f8f9fa;">
                    <children>
                        <!-- Top Bar -->
                        <HBox alignment="CENTER_LEFT" styleClass="admin-top-bar" prefHeight="60">
                            <padding>
                                <Insets left="20" right="20" />
                            </padding>
                            <children>
                                <VBox alignment="CENTER_LEFT">
                                    <Label text="FIRMETNA Administration" styleClass="admin-top-title" />
                                    <Label text="Gestion complète de la plateforme" styleClass="admin-top-subtitle" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER" spacing="15">
                                    <children>
                                        <VBox alignment="CENTER_RIGHT">
                                            <Label text="Admin" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                                            <Label text="Connecté" style="-fx-font-size: 11; -fx-text-fill: #27ae60;" />
                                        </VBox>
                                        <StackPane style="-fx-background-color: #dfe6e9; -fx-background-radius: 50; -fx-padding: 8;">
                                            <Label text="👤" style="-fx-font-size: 16;" />
                                        </StackPane>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Dynamic Content Area -->
                        <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </center>
        </BorderPane>

        <!-- ================= CHATBOT LAYER ================= -->
        <AnchorPane pickOnBounds="false">
            <children>
                <AnchorPane fx:id="chatbotContainer" prefWidth="280.0" prefHeight="350.0" visible="false" managed="false" layoutX="800.0" layoutY="300.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #ddd; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);">
                    <children>
                        <HBox prefWidth="280.0" prefHeight="40.0" alignment="CENTER_LEFT" style="-fx-background-color: rgba(0,0,0,0.05); -fx-padding: 0 10;">
                            <children>
                                <Label text="Assistant Admin" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="✖" onAction="#toggleChatbot" style="-fx-background-color: transparent; -fx-text-fill: #888;" />
                            </children>
                        </HBox>
                        <ScrollPane fx:id="chatScrollPane" layoutX="10.0" layoutY="45.0" prefWidth="260.0" prefHeight="240.0" hbarPolicy="NEVER">
                            <content>
                                <VBox fx:id="chatMessages" spacing="5" style="-fx-padding: 5;" />
                            </content>
                        </ScrollPane>
                        <HBox layoutX="10.0" layoutY="300.0" spacing="5">
                            <children>
                                <TextField fx:id="chatInput" onAction="#handleSendChat" promptText="Message..." prefWidth="200.0" />
                                <Button text="➤" onAction="#handleSendChat" style="-fx-background-color: #2e8b57; -fx-text-fill: white;" />
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>

                <Button fx:id="chatbotToggleButton" text="💬" onAction="#toggleChatbot" layoutX="900.0" layoutY="600.0" style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 12; -fx-font-size: 16; -fx-cursor: hand;" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
