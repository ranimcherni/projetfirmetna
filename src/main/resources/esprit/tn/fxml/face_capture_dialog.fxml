<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="15" prefHeight="450.0" prefWidth="500.0" style="-fx-padding: 20; -fx-background-color: white; -fx-border-color: #27ae60; -fx-border-width: 3; -fx-border-radius: 5; -fx-background-radius: 5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FaceCaptureDialogController">
    <children>
        <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Reconnaissance Faciale" />
        <Label style="-fx-text-fill: #7f8c8d;" text="Regardez la caméra et placez votre visage au centre" />
        
        <VBox alignment="CENTER" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5;">
             <ImageView fx:id="webcamView" fitHeight="300.0" fitWidth="400.0" preserveRatio="true" />
        </VBox>
        
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="captureButton" onAction="#handleCapture" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 5;" text="🔍 Analyser Mon Visage" />
            <Button onAction="#handleCancel" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 5;" text="Annuler" />
        </HBox>
        
        <Label fx:id="statusLabel" text="Initialisation de la caméra..." style="-fx-text-fill: #e67e22; -fx-font-weight: bold;" />
    </children>
</VBox>
