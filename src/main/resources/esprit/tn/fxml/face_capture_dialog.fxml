<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootVBox" alignment="TOP_CENTER" spacing="0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FaceCaptureDialogController" 
      styleClass="face-container" stylesheets="@../css/style.css">
    <children>
        <!-- Custom Header -->
        <HBox alignment="CENTER_LEFT" styleClass="face-header">
            <Label text="Vérification Biométrique" styleClass="face-header-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleCancel" text="✕" styleClass="mfa-close-btn" style="-fx-text-fill: white;" />
        </HBox>

        <VBox alignment="CENTER" spacing="20" styleClass="face-body">
            <VBox alignment="CENTER" spacing="5">
                <Label text="Reconnaissance Faciale" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1b4332;" />
                <Label text="Regardez la caméra et restez immobile" styleClass="mfa-subtitle" />
            </VBox>
            
            <StackPane styleClass="camera-preview-container">
                <ImageView fx:id="webcamView" fitHeight="320.0" fitWidth="420.0" preserveRatio="true" />
                <!-- Subtle scan line effect could be added here if desired -->
            </StackPane>
            
            <VBox alignment="CENTER" spacing="15">
                <Label fx:id="statusLabel" text="Initialisation de la caméra..." styleClass="face-status-label" />
                
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="captureButton" onAction="#handleCapture" text="Démarrer l'analyse" styleClass="face-scan-btn" />
                    <Button onAction="#handleCancel" text="Annuler" styleClass="dialog-btn-secondary" style="-fx-padding: 13 30;" />
                </HBox>
            </VBox>
        </VBox>
    </children>
</VBox>
