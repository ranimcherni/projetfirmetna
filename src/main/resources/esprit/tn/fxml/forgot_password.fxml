<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane alignment="CENTER" prefHeight="730.0" prefWidth="1100.0" styleClass="auth-root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ForgotPasswordController">
    <children>
        <VBox style="-fx-background-color: rgba(0,0,0,0.15);" StackPane.alignment="CENTER" />

        <VBox alignment="CENTER" maxHeight="600.0" maxWidth="450.0" spacing="25" styleClass="glass-card">
            <children>
                <VBox alignment="CENTER" spacing="20" style="-fx-background-color: transparent; -fx-padding: 30 40 10 40;">
                    <children>
                        <ImageView fitHeight="60.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/logo1.png" />
                            </image>
                        </ImageView>
                        <Label style="-fx-text-fill: #27ae60; -fx-font-size: 24; -fx-font-weight: bold; -fx-letter-spacing: 1.2;" text="RÉCUPÉRATION" />
                        <Label fx:id="instructionLabel" textAlignment="CENTER" wrapText="true" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;" text="Entrez votre email pour recevoir un code de vérification." />
                        <Label fx:id="errorLabel" managed="false" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 13;" visible="false" />
                        <Label fx:id="successLabel" managed="false" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 13;" visible="false" />
                    </children>
                </VBox>

                <!-- ÉTAPE 1: Email -->
                <VBox fx:id="step1Box" spacing="18">
                    <children>
                        <VBox spacing="6">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 13;" text="Adresse Email" />
                                <TextField fx:id="emailField" promptText="votre@email.com" styleClass="auth-field" />
                            </children>
                        </VBox>
                        <Button maxWidth="Infinity" onAction="#handleSendCode" styleClass="auth-primary-btn" text="ENVOYER LE CODE" />
                    </children>
                </VBox>

                <!-- ÉTAPE 2: Code de vérification -->
                <VBox fx:id="step2Box" managed="false" visible="false" spacing="18">
                    <children>
                        <VBox spacing="6">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 13;" text="Code à 6 chiffres" />
                                <TextField fx:id="codeField" promptText="123456" styleClass="auth-field" style="-fx-alignment: center; -fx-font-size: 18; -fx-letter-spacing: 5px;" />
                            </children>
                        </VBox>
                        <Button maxWidth="Infinity" onAction="#handleVerifyCode" styleClass="auth-primary-btn" text="VÉRIFIER LE CODE" />
                    </children>
                </VBox>

                <!-- ÉTAPE 3: Nouveau mot de passe -->
                <VBox fx:id="step3Box" managed="false" visible="false" spacing="18">
                    <children>
                        <VBox spacing="6">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 13;" text="Nouveau mot de passe" />
                                <PasswordField fx:id="newPasswordField" promptText="••••••••" styleClass="auth-field" />
                            </children>
                        </VBox>
                        <VBox spacing="6">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 13;" text="Confirmer le mot de passe" />
                                <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="auth-field" />
                            </children>
                        </VBox>
                        <Button maxWidth="Infinity" onAction="#handleResetPassword" styleClass="auth-primary-btn" text="CHANGER LE MOT DE PASSE" />
                    </children>
                </VBox>

                <Separator maxWidth="200.0" opacity="0.3" />
                <Button onAction="#goBackToLogin" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13;" styleClass="link-button" text="Retour à la connexion" />
            </children>
        </VBox>
    </children>
</StackPane>
