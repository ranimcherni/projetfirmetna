<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminCommandesController" stylesheets="@../css/style.css">
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox>
                    <Label text="Gestion Commandes" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                    <Label text="Suivez et gérez toutes les commandes de la plateforme" style="-fx-text-fill: #636e72; -fx-font-size: 13;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <!-- Statistics Section -->
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
            <children>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Total Commandes" styleClass="admin-stat-label" />
                    <Label fx:id="totalCommandesLabel" text="0" styleClass="admin-stat-value" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Commandes Confirmées" styleClass="admin-stat-label" />
                    <Label fx:id="confirmedCommandesLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #27ae60;" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Commandes En Attente" styleClass="admin-stat-label" />
                    <Label fx:id="pendingCommandesLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #fdcb6e;" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Commandes Annulées" styleClass="admin-stat-label" />
                    <Label fx:id="cancelledCommandesLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #d63031;" />
                </VBox>
            </children>
        </HBox>

        <!-- Revenue Statistics -->
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
            <children>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Chiffre d'affaires Total" styleClass="admin-stat-label" />
                    <Label fx:id="totalRevenueLabel" text="0 TND" styleClass="admin-stat-value" style="-fx-text-fill: #00b894;" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Montant Moyen par Commande" styleClass="admin-stat-label" />
                    <Label fx:id="averageOrderValueLabel" text="0 TND" styleClass="admin-stat-value" style="-fx-text-fill: #0984e3;" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Commande Maximale" styleClass="admin-stat-label" />
                    <Label fx:id="maxOrderValueLabel" text="0 TND" styleClass="admin-stat-value" style="-fx-text-fill: #6c5ce7;" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Commande Minimale" styleClass="admin-stat-label" />
                    <Label fx:id="minOrderValueLabel" text="0 TND" styleClass="admin-stat-value" style="-fx-text-fill: #a29bfe;" />
                </VBox>
            </children>
        </HBox>

        <!-- Filter Section -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="admin-filter-bar">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <children>
                <TextField fx:id="searchField" prefWidth="400" prefHeight="45" promptText="Rechercher par client, email ou adresse..." styleClass="admin-search-field" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="statusFilter" prefWidth="230" prefHeight="45" promptText="Filtrer par statut" styleClass="admin-combo-filter" />
            </children>
        </HBox>

        <!-- Commandes Table -->
        <TableView fx:id="commandesTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60" />
                <TableColumn fx:id="clientCol" text="Client" prefWidth="150" />
                <TableColumn fx:id="emailCol" text="Email" prefWidth="180" />
                <TableColumn fx:id="adresseCol" text="Adresse de Livraison" prefWidth="200" />
                <TableColumn fx:id="totalCol" text="Montant" prefWidth="100" />
                <TableColumn fx:id="statutCol" text="Statut" prefWidth="120" />
                <TableColumn fx:id="dateCol" text="Date" prefWidth="120" />
                <TableColumn fx:id="commentaireCol" text="Commentaire" prefWidth="180" />
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
