<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProfileController">
    <children>
        <!-- Background Layer -->
        <VBox styleClass="front-root-bg" />

        <!-- Main Content Overlay -->
        <VBox spacing="20">
            <children>
                <!-- NAVIGATION BAR -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 Accueil" />
                                <MenuButton styleClass="nav-item-dropdown" text="📦 Produits">
                                    <items>
                                        <MenuItem text="Fruits" />
                                        <MenuItem text="Légumes" />
                                    </items>
                                </MenuButton>
                                <Button styleClass="nav-item" text="📅 Événements" />
                                <Button styleClass="nav-item" text="💬 Forum" />
                                <Button styleClass="nav-item" text="🔔 Notifications" />
                                <Button styleClass="nav-item" text="❤ Dons" />
                                <Button styleClass="nav-item" text="🤝 Partenariats" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleBack" text="Mon Compte" />
                                <MenuItem text="Mes Publications" />
                                <MenuItem text="Mon Panier" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleLogout" text="Deconnexion" style="-fx-text-fill: #e74c3c;" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <!-- Centered Profile Card -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox alignment="CENTER" style="-fx-padding: 40 0;">
                            <children>
                                <VBox maxWidth="900" spacing="0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 0); -fx-overflow: hidden;">
                                    <children>
                                        <!-- Card Header -->
                                        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #218c53; -fx-padding: 40 0;">
                                            <children>
                                                <StackPane>
                                                    <Circle fill="WHITE" radius="60" />
                                                    <Label text="P" style="-fx-font-size: 55; -fx-text-fill: #218c53;" />
                                                </StackPane>
                                                <VBox alignment="CENTER" spacing="5">
                                                    <Label fx:id="headerNameLabel" style="-fx-text-fill: white; -fx-font-size: 32; -fx-font-weight: bold;" text="Nom Utilisateur" />
                                                    <Label fx:id="headerRoleLabel" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 16;" text="Client" />
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <!-- Card Content -->
                                        <VBox spacing="35" style="-fx-padding: 40 60;">
                                            <children>
                                                <GridPane hgap="40" vgap="25">
                                                    <columnConstraints>
                                                        <ColumnConstraints minWidth="180" prefWidth="180" />
                                                        <ColumnConstraints hgrow="ALWAYS" />
                                                    </columnConstraints>
                                                    <children>
                                                        <Label text="Prénom &amp; Nom" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #444;" />
                                                        <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                                            <children>
                                                                <HBox spacing="10">
                                                                    <VBox HBox.hgrow="ALWAYS">
                                                                        <TextField fx:id="prenomField" styleClass="form-field" promptText="Prénom" />
                                                                        <Label fx:id="prenomError" styleClass="error-message-label" text="Prénom invalide" />
                                                                    </VBox>
                                                                    <VBox HBox.hgrow="ALWAYS">
                                                                        <TextField fx:id="nomField" styleClass="form-field" promptText="Nom" />
                                                                        <Label fx:id="nomError" styleClass="error-message-label" text="Nom invalide" />
                                                                    </VBox>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                        
                                                        <Label text="Email" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #444;" />
                                                        <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                                            <children>
                                                                <TextField fx:id="emailField" styleClass="form-field" />
                                                                <Label fx:id="emailError" styleClass="error-message-label" text="Email invalide" />
                                                            </children>
                                                        </VBox>
                                                        
                                                        <Label text="Téléphone" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #444;" />
                                                        <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                                            <children>
                                                                <TextField fx:id="phoneField" styleClass="form-field" />
                                                                <Label fx:id="phoneError" styleClass="error-message-label" text="Téléphone invalide" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </GridPane>

                                                <Separator />

                                                <!-- Mes Publications Section (from Screenshot) -->
                                                <VBox spacing="15">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                                            <Label text="Pubs" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1b4332;" />
                                                            <Label text="Mes Publications" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1b4332;" />
                                                        </HBox>
                                                        <Label text="Vous avez créé 0 publication sur le forum." style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;" />
                                                        <HBox spacing="15">
                                                            <Button text="Voir toutes mes publications" style="-fx-background-color: #218c53; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 20; -fx-cursor: hand;" />
                                                            <Button text="+ Nouvelle publication" style="-fx-background-color: transparent; -fx-border-color: #218c53; -fx-border-radius: 20; -fx-text-fill: #218c53; -fx-padding: 10 20; -fx-cursor: hand;" />
                                                        </HBox>
                                                    </children>
                                                </VBox>

                                                <!-- Footer Actions -->
                                                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30 0 0 0; -fx-border-color: #eee; -fx-border-width: 1 0 0 0;">
                                                    <children>
                                                        <Button onAction="#handleUpdate" style="-fx-background-color: #218c53; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 25; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;" text="Modifier" />
                                                        <Button onAction="#handleAccueil" text="Retour" style="-fx-background-color: transparent; -fx-border-color: #bdc3c7; -fx-border-radius: 10; -fx-text-fill: #7f8c8d; -fx-padding: 11 20; -fx-cursor: hand;" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button onAction="#handleDelete" text="Supprimer" style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 12 25; -fx-font-weight: bold; -fx-cursor: hand;" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</StackPane>
