<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminDonationsOffresController">
    <children>
        <!-- Background Layer -->
        <VBox styleClass="front-root-bg" />
        <VBox mouseTransparent="true" styleClass="front-bg-overlay" />

        <VBox spacing="0">
            <children>
                <!-- NAVIGATION BAR (TOP) -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 Accueil" />
                                <MenuButton styleClass="nav-item-dropdown" text="📦 Produits">
                                    <items>
                                        <MenuItem onAction="#handleProduits" text="Tous les produits" />
                                        <MenuItem onAction="#handleProduitsVegetaux" text="Végétaux" />
                                        <MenuItem onAction="#handleProduitsAnimaux" text="Animaux" />
                                    </items>
                                </MenuButton>
                                <Button onAction="#handleEvenements" styleClass="nav-item" text="📅 Événements" />
                                <Button onAction="#handleForum" styleClass="nav-item" text="💬 Forum" />
                                <Button styleClass="nav-item-active" text="❤ Dons" />
                                <Button onAction="#handlePartenariats" styleClass="nav-item" text="🤝 Partenariats" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleLogout" style="-fx-text-fill: #e74c3c;" text="Deconnexion" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <!-- MAIN CONTENT -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox alignment="CENTER" style="-fx-padding: 40 0;">
                            <children>
                                <VBox maxWidth="1000" spacing="25">
                                    <children>
                                        <!-- HEADER CARD -->
                                        <VBox styleClass="glass-card" style="-fx-padding: 30; -fx-background-radius: 20;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <VBox spacing="5">
                                                            <children>
                                                                <Label text="Partage et Solidarité" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                                                <Label text="Gérez vos offres de dons et aidez la communauté Firmetna" style="-fx-font-size: 15; -fx-text-fill: #666;" />
                                                            </children>
                                                        </VBox>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <VBox spacing="10" alignment="CENTER">
                                                            <children>
                                                                <Button onAction="#handleStatistics" styleClass="action-btn-secondary" text="🏆 Classement Donateurs" />
                                                                <Hyperlink onAction="#handleSwitchToDemandes" text="Voir les demandes →" style="-fx-text-fill: #2d5a27; -fx-font-weight: bold;" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- FORM CARD -->
                                        <VBox spacing="30" styleClass="glass-card" style="-fx-padding: 40; -fx-background-radius: 20;">
                                            <children>
                                                <Label text="Détails de l'Offre" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                                
                                                <GridPane hgap="30" vgap="25">
                                                    <columnConstraints>
                                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                    </columnConstraints>
                                                    <children>
                                                        <VBox spacing="10">
                                                            <children>
                                                                <Label text="Catégorie du Produit" style="-fx-font-weight: bold; -fx-text-fill: #444;" />
                                                                <TextField fx:id="categorieField" promptText="Ex: Semences, Engrais..." styleClass="form-field" />
                                                                <Label fx:id="errorCategorie" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="10" GridPane.columnIndex="1">
                                                            <children>
                                                                <Label text="Téléphone de Contact" style="-fx-font-weight: bold; -fx-text-fill: #444;" />
                                                                <TextField fx:id="telephoneField" promptText="Votre numéro" styleClass="form-field" />
                                                                <Label fx:id="errorTelephone" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="10" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label text="Quantité Disponible" style="-fx-font-weight: bold; -fx-text-fill: #444;" />
                                                                <TextField fx:id="quantiteField" promptText="Nombre d'unités" styleClass="form-field" />
                                                                <Label fx:id="errorQuantite" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label text="Lien de la Photo" style="-fx-font-weight: bold; -fx-text-fill: #444;" />
                                                                <TextField fx:id="photoField" promptText="URL de l'image" styleClass="form-field" />
                                                                <Label fx:id="errorPhoto" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </GridPane>

                                                <VBox spacing="10">
                                                    <children>
                                                        <Label text="Description de l'Offre" style="-fx-font-weight: bold; -fx-text-fill: #444;" />
                                                        <TextArea fx:id="descriptionField" prefHeight="100.0" promptText="Décrivez votre don..." styleClass="form-field" wrapText="true" />
                                                        <Label fx:id="errorDescription" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                                    </children>
                                                </VBox>

                                                <HBox spacing="20" alignment="CENTER_RIGHT">
                                                    <children>
                                                        <Button onAction="#handleClear" styleClass="action-btn-secondary" text="Réinitialiser" />
                                                        <Button onAction="#handleAdd" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 30; -fx-font-weight: bold; -fx-cursor: hand;" text="Publier l'Offre" />
                                                        <Button onAction="#handleUpdate" style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 30; -fx-font-weight: bold; -fx-cursor: hand;" text="Mettre à jour" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- TABLE CARD -->
                                        <VBox spacing="20" styleClass="glass-card" style="-fx-padding: 30; -fx-background-radius: 20;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="20">
                                                    <children>
                                                        <Label text="Mes Contributions" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <TextField fx:id="searchField" prefWidth="250.0" promptText="🔍 Rechercher..." styleClass="search-bar-modern" />
                                                        <ComboBox fx:id="sortCombo" prefWidth="150.0" styleClass="form-field" />
                                                        <CheckBox fx:id="stockOnlyCheck" text="En stock" style="-fx-text-fill: #444; -fx-font-weight: bold;" />
                                                    </children>
                                                </HBox>

                                                <TableView fx:id="offreTable" prefHeight="350.0" styleClass="modern-table">
                                                    <columns>
                                                        <TableColumn fx:id="colCategorie" prefWidth="150.0" text="Catégorie" />
                                                        <TableColumn fx:id="colTelephone" prefWidth="120.0" text="Téléphone" />
                                                        <TableColumn fx:id="colQuantite" prefWidth="100.0" text="Quantité" />
                                                        <TableColumn fx:id="colDescription" prefWidth="350.0" text="Description" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                                
                                                <HBox alignment="CENTER_RIGHT">
                                                    <children>
                                                        <Button onAction="#handleDelete" style="-fx-background-color: transparent; -fx-border-color: #e74c3c; -fx-text-fill: #e74c3c; -fx-border-radius: 10; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑 Supprimer" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <!-- FLOAT BUTTON CHATBOT -->
        <AnchorPane pickOnBounds="false">
            <children>
                <Button onAction="#handleOpenChatbot" styleClass="chatbot-float-btn" text="🤖" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
