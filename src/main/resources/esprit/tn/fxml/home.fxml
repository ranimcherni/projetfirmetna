<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HomeController">
    <children>
        <!-- NAV BAR / HEADER -->
        <HBox alignment="CENTER" prefHeight="80.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets left="50" right="50" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fitHeight="40" preserveRatio="true">
                            <image>
                                <Image url="@../images/logo1.png" />
                            </image>
                        </ImageView>
                        <Label styleClass="brand-label" text="FIRMETNA" textFill="#2d5a27" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="35">
                    <children>
                        <Hyperlink style="-fx-text-fill: #2d5a27; -fx-font-weight: bold; -fx-font-size: 15;" text="Accueil" />
                        <HBox alignment="CENTER" spacing="15">
                            <children>
                                <VBox fx:id="profileBox" alignment="CENTER_RIGHT" managed="false" visible="false">
                                    <children>
                                        <Label fx:id="welcomeLabel" style="-fx-text-fill: #2d3436; -fx-font-size: 14;" />
                                    </children>
                                </VBox>
                                <Button fx:id="loginBtn" onAction="#handleGoToLogin" styleClass="login-header-btn" text="CONNEXION" />
                                <Button fx:id="logoutBtn" managed="false" onAction="#handleLogout" styleClass="logout-btn" text="DÉCONNEXION" visible="false" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- SCROLLABLE CONTENT -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white; -fx-background: white;" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="0" style="-fx-background-color: white;">
                    <children>
                        <!-- HERO SECTION (REVERTED TO ORIGINAL) -->
                        <StackPane minHeight="550.0" prefHeight="550.0" styleClass="home-bg">
                            <children>
                                <VBox alignment="CENTER" spacing="25" style="-fx-background-color: rgba(0,0,0,0.35); -fx-padding: 0 80;">
                                    <children>
                                        <Label alignment="CENTER" style="-fx-text-fill: white; -fx-font-size: 64; -fx-font-weight: bold;" text="Firmetna" />
                                        <Label alignment="CENTER" maxWidth="750.0" style="-fx-text-fill: white; -fx-font-size: 19; -fx-line-spacing: 5; -fx-text-alignment: CENTER;" text="Découvrez l'excellence de notre ferme. Nous produisons des aliments sains et naturels, dans le respect total de l'environnement." wrapText="true" />
                                        <Button style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 18; -fx-padding: 15 45; -fx-background-radius: 30; -fx-font-weight: bold; -fx-cursor: hand;" text="Explorer" />
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                        <!-- ICON MODULES -->
                        <HBox alignment="CENTER" spacing="60" style="-fx-padding: 60 0; -fx-background-color: #f9fbf9;">
                            <children>
                                <VBox styleClass="icon-box">
                                    <Label styleClass="green-icon" text="📦" />
                                    <Label styleClass="icon-text" text="PRODUITS" />
                                </VBox>
                                <VBox styleClass="icon-box">
                                    <Label styleClass="green-icon" text="📅" />
                                    <Label styleClass="icon-text" text="ÉVÉNEMENTS" />
                                </VBox>
                                <VBox styleClass="icon-box">
                                    <Label styleClass="green-icon" text="💬" />
                                    <Label styleClass="icon-text" text="FORUM" />
                                </VBox>
                                <VBox styleClass="icon-box">
                                    <Label styleClass="green-icon" text="❤" />
                                    <Label styleClass="icon-text" text="DONS" />
                                </VBox>
                                <VBox styleClass="icon-box" onMouseClicked="#handleGoToFrontPartner" style="-fx-cursor: hand;">
                                    <Label styleClass="green-icon" text="🤝" />
                                    <Label styleClass="icon-text" text="PARTENAIRES" />
                                </VBox>
                            </children>
                        </HBox>

                        <!-- ABOUT SECTION -->
                        <HBox alignment="CENTER_LEFT" styleClass="about-section">
                            <children>
                                <VBox maxWidth="550.0" spacing="25">
                                    <children>
                                        <Label styleClass="about-header" text="À PROPOS DE NOUS" />
                                        <Label styleClass="about-main-title" text="Dédié à l'agriculture durable et respectueuse." wrapText="true" />
                                        <Label styleClass="about-body-text" text="Depuis des générations, Firmetna s'engage à fournir les meilleurs produits de la terre tunisienne. Nous combinons savoir-faire ancestral et technologies modernes pour une alimentation saine." wrapText="true" />
                                        <Label styleClass="learn-more" text="EN SAVOIR PLUS →" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- PRODUCT GALLERY -->
                        <VBox alignment="CENTER" spacing="40" style="-fx-padding: 80 50; -fx-background-color: #f5f6fa;">
                            <children>
                                <Label style="-fx-text-fill: #1b4332; -fx-font-size: 32; -fx-font-weight: bold;" text="NOS CATÉGORIES" />
                                <GridPane hgap="25" vgap="25" alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                                    </columnConstraints>
                                    <children>
                                        <VBox minHeight="380" styleClass="panel-legumes" GridPane.columnIndex="0">
                                            <children>
                                                <VBox alignment="BOTTOM_LEFT" styleClass="panel-overlay" VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="panel-title" text="Légumes" />
                                                        <Label styleClass="panel-subtitle" text="Végétaux Frais" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <VBox minHeight="380" styleClass="panel-fruits" GridPane.columnIndex="1">
                                            <children>
                                                <VBox alignment="BOTTOM_LEFT" styleClass="panel-overlay" VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="panel-title" text="Fruits" />
                                                        <Label styleClass="panel-subtitle" text="Récolte du Jour" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <VBox minHeight="380" styleClass="panel-miel" GridPane.columnIndex="2">
                                            <children>
                                                <VBox alignment="BOTTOM_LEFT" styleClass="panel-overlay" VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="panel-title" text="Miel" />
                                                        <Label styleClass="panel-subtitle" text="Pur &amp; Naturel" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <VBox minHeight="380" styleClass="panel-oeufs" GridPane.columnIndex="3">
                                            <children>
                                                <VBox alignment="BOTTOM_LEFT" styleClass="panel-overlay" VBox.vgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="panel-title" text="Œufs" />
                                                        <Label styleClass="panel-subtitle" text="Bio &amp; Frais" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
