<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #f5f6fa; -fx-padding: 30;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PartnerController">
    
    <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Gestion des Partenaires" />

    <!-- Form Section -->
    <HBox spacing="20">
        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Nom:" />
                <TextField fx:id="txtName" promptText="Nom du partenaire" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Type:" />
                <ComboBox fx:id="cmbType" promptText="Sélectionner le type" prefWidth="250.0" />
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Email:" />
                <TextField fx:id="txtEmail" promptText="email@exemple.com" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Téléphone:" />
                <TextField fx:id="txtPhone" promptText="Numéro de téléphone" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <HBox spacing="15">
                <Label prefWidth="80.0" text="Adresse:" />
                <TextArea fx:id="txtAddress" prefHeight="100.0" promptText="Adresse complète..." HBox.hgrow="ALWAYS" />
            </HBox>
            
            <!-- Buttons Section -->
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <padding>
                    <Insets top="10" />
                </padding>
                <Button onAction="#handleAdd" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Ajouter" />
                <Button onAction="#handleUpdate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" text="Modifier" />
                <Button onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Supprimer" />
                <Button onAction="#handleClear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" text="Vider" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Search and Actions Section -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="🔍 Rechercher par nom ou email..." prefWidth="300.0" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleGenerateQR" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" text="📱 Générer QR" />
        <Button onAction="#handleExportCSV" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold;" text="📥 Exporter CSV" />
    </HBox>

    <!-- Table Section -->
    <TableView fx:id="tablePartners" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="150.0" text="Nom" />
            <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
            <TableColumn fx:id="colPhone" prefWidth="120.0" text="Téléphone" />
            <TableColumn fx:id="colCreatedAt" prefWidth="150.0" text="Date Création" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
