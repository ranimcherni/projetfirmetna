<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="25.0" style="-fx-background-color: #f4f7f6; -fx-padding: 30;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PartnerController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Gestion des Partenaires" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10.0">
                    <children>
                        <Button onAction="#handleGenerateQR" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="📱 QR Code" />
                        <Button onAction="#handleExportCSV" style="-fx-background-color: #9b59b6; -fx-text-fill: white;" text="📥 Export CSV" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Form Card -->
        <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <children>
                <HBox spacing="20.0">
                    <children>
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Informations Générales" />
                                <TextField fx:id="txtName" promptText="Nom de l'entreprise / Partenaire" styleClass="text-field-custom" />
                                <ComboBox fx:id="cmbType" maxWidth="1.7976931348623157E308" promptText="Type de partenariat" />
                            </children>
                        </VBox>
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Contact" />
                                <TextField fx:id="txtEmail" promptText="Email de contact" styleClass="text-field-custom" />
                                <TextField fx:id="txtPhone" promptText="Numéro de téléphone" styleClass="text-field-custom" />
                            </children>
                        </VBox>
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Localisation" />
                                <TextArea fx:id="txtAddress" prefHeight="80.0" promptText="Adresse du siège..." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button onAction="#handleClear" styleClass="btn-secondary" text="Réinitialiser" />
                        <Button onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Supprimer" />
                        <Button onAction="#handleUpdate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Modifier" />
                        <Button onAction="#handleAdd" styleClass="btn-primary" text="Ajouter Partenaire" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="txtSearch" prefWidth="400.0" promptText="🔍 Rechercher un partenaire (Nom, Email...)" styleClass="text-field-custom" />
            </children>
        </HBox>

        <!-- Table -->
        <TableView fx:id="tablePartners" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="200.0" text="Nom" />
                <TableColumn fx:id="colType" prefWidth="150.0" text="Type" />
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="colPhone" prefWidth="150.0" text="Téléphone" />
                <TableColumn fx:id="colCreatedAt" prefWidth="180.0" text="Date Inscription" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
