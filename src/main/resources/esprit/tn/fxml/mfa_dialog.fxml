<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<VBox fx:id="rootVBox" alignment="TOP_CENTER" spacing="0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MfaDialogController" 
      styleClass="mfa-container" stylesheets="@../css/style.css">
    <children>
        <!-- Header with Close Button -->
        <HBox alignment="CENTER_RIGHT" prefWidth="400">
            <Button onAction="#handleCancel" text="✕" styleClass="mfa-close-btn" />
        </HBox>

        <VBox alignment="CENTER" spacing="25">
            <VBox alignment="CENTER" spacing="5">
                <Label text="Sécurité Double Facteur" styleClass="mfa-title" />
                <Label text="Vérification Google Authenticator" styleClass="mfa-subtitle" />
            </VBox>
            
            <VBox fx:id="setupBox" spacing="15" alignment="CENTER" managed="false" visible="false" styleClass="mfa-qr-card">
                <Label text="Scannez ce QR Code" style="-fx-font-weight: bold; -fx-text-fill: #1b4332;" />
                <StackPane style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 10;">
                    <ImageView fx:id="qrCodeView" fitHeight="160" fitWidth="160" preserveRatio="true" />
                </StackPane>
                <VBox spacing="5" alignment="CENTER">
                    <Label text="Clé de configuration manuelle :" styleClass="mfa-subtitle" />
                    <Label fx:id="secretKeyLabel" styleClass="mfa-secret-badge" />
                </VBox>
            </VBox>

            <VBox spacing="20" alignment="CENTER">
                <Label text="Entrez votre code de sécurité" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                
                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="code1" styleClass="mfa-input-box" />
                    <TextField fx:id="code2" styleClass="mfa-input-box" />
                    <TextField fx:id="code3" styleClass="mfa-input-box" />
                    <TextField fx:id="code4" styleClass="mfa-input-box" />
                    <TextField fx:id="code5" styleClass="mfa-input-box" />
                    <TextField fx:id="code6" styleClass="mfa-input-box" />
                </HBox>
                
                <Label fx:id="errorLabel" text="Code invalide !" textFill="#fa5252" visible="false" style="-fx-font-weight: bold;" />
            </VBox>

            <Button fx:id="verifyButton" onAction="#handleVerify" text="Vérifier l'identité" styleClass="mfa-verify-btn" />
            
            <Label text="Besoin d'aide ? Contactez le support" styleClass="mfa-subtitle" style="-fx-font-size: 11; -fx-cursor: hand;" />
        </VBox>
    </children>
</VBox>
