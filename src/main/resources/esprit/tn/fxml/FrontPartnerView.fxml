<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f9fbf9;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontPartnerController">
    
    <!-- Top Navigation Bar -->
    <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets left="50" right="50" />
        </padding>
        <Button onAction="#handleGoBack" style="-fx-background-color: transparent; -fx-text-fill: #2d5a27; -fx-font-weight: bold; -fx-font-size: 16; -fx-cursor: hand;" text="← Retour à l'accueil" />
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" text="Espace Partenaires" />
        </HBox>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        
        <!-- Public Section (Visible by default) -->
        <VBox fx:id="publicSection" spacing="20" style="-fx-padding: 30;" visible="true">
            <!-- Login Box at the top right or center -->
            <HBox alignment="CENTER_RIGHT">
                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <Label text="Partenaire existant ?" style="-fx-font-weight: bold; -fx-text-fill: #1b4332;" />
                    <TextField fx:id="txtLoginEmail" promptText="votre.email@exemple.com" styleClass="auth-field" />
                    <Button onAction="#handleLogin" styleClass="auth-primary-btn" text="Connexion" />
                    <Label fx:id="lblError" text="" styleClass="error-message-label" visible="false" />
                </HBox>
            </HBox>

            <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Nos Partenaires de Confiance" />
            <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;" text="Rejoignez notre réseau grandissant d'agriculteurs, distributeurs et investisseurs !" />
            
            <TableView fx:id="tablePublicPartners" VBox.vgrow="ALWAYS" style="-fx-font-size: 14;">
                <columns>
                    <TableColumn fx:id="colPublicName" prefWidth="200.0" text="Nom du Partenaire" />
                    <TableColumn fx:id="colPublicType" prefWidth="150.0" text="Type" />
                    <TableColumn fx:id="colPublicAddress" prefWidth="300.0" text="Adresse" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Dashboard Section (Hidden by default) -->
        <VBox fx:id="dashboardSection" spacing="30" style="-fx-padding: 40;" visible="false">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 18; -fx-text-fill: #7f8c8d;" text="Bienvenue," />
                    <Label fx:id="lblPartnerName" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" text="Nom du Partenaire" />
                    <Label fx:id="lblPartnerInfo" style="-fx-font-size: 14; -fx-text-fill: #34495e;" text="Type | Email | Téléphone" />
                </VBox>
                
                <!-- API 1: Weather Widget -->
                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: linear-gradient(to bottom right, #3498db, #2980b9); -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" prefWidth="250">
                    <Label text="🌤 Météo Agricole (Tunis)" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;" />
                    <Label fx:id="lblWeather" text="Chargement..." style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
                </VBox>
            </HBox>

            <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Vos Contrats &amp; Offres" />

            <TableView fx:id="tableContracts" VBox.vgrow="ALWAYS" style="-fx-font-size: 14;">
                <columns>
                    <TableColumn fx:id="colTitle" prefWidth="250.0" text="Titre du Contrat" />
                    <TableColumn fx:id="colValue" prefWidth="120.0" text="Valeur (TND)" />
                    <TableColumn fx:id="colStartDate" prefWidth="120.0" text="Date Début" />
                    <TableColumn fx:id="colEndDate" prefWidth="120.0" text="Date Fin" />
                    <TableColumn fx:id="colStatus" prefWidth="120.0" text="Statut" />
                    <TableColumn fx:id="colTimeLeft" prefWidth="250.0" text="Temps Restant" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

    </StackPane>
</VBox>
