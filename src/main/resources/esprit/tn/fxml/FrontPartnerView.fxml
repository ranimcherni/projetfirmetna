<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800.0" prefWidth="1200.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontPartnerController">
    <!-- Background Image -->
    <VBox style="-fx-background-image: url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?q=80&amp;w=1600&amp;auto=format&amp;fit=crop'); -fx-background-size: cover; -fx-background-position: center;" />
    
    <!-- Dark/Green Overlay -->
    <VBox style="-fx-background-color: rgba(27, 67, 50, 0.4);" />

    <VBox spacing="0">
    
    <!-- Top Navigation Bar -->
    <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-backdrop-filter: blur(20px); -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets left="50" right="50" />
        </padding>
        <Button onAction="#handleGoBack" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 20; -fx-padding: 8 15;" text="← Retour à l'accueil" />
        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);" text="🤝 Espace Partenaires" />
        </HBox>
        <Region prefWidth="150" />
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        
        <!-- Public Section (Visible by default) -->
        <VBox fx:id="publicSection" alignment="CENTER" spacing="40" style="-fx-padding: 60;" visible="true">
            <VBox alignment="CENTER" spacing="10">
                <Label style="-fx-font-size: 42; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 5);" text="Développons ensemble l'agriculture de demain" textAlignment="CENTER" wrapText="true" />
                <Label style="-fx-font-size: 18; -fx-text-fill: rgba(255,255,255,0.9); -fx-font-style: italic;" text="Rejoignez les leaders de l'agritech en Tunisie" />
            </VBox>

            <HBox alignment="CENTER" spacing="40">
                <!-- Partners List Card -->
                <VBox styleClass="glass-card" prefWidth="800" spacing="20" style="-fx-background-color: rgba(255,255,255,0.95);">
                    <Label styleClass="dashboard-title" text="Nos Partenaires de Confiance" style="-fx-font-size: 24;" />
                    <TableView fx:id="tablePublicPartners" prefHeight="350" styleClass="admin-table">
                        <columns>
                            <TableColumn fx:id="colPublicName" prefWidth="200.0" text="Nom du Partenaire" />
                            <TableColumn fx:id="colPublicType" prefWidth="150.0" text="Type" />
                            <TableColumn fx:id="colPublicAddress" prefWidth="300.0" text="Adresse" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Login Box -->
                <VBox styleClass="glass-card" alignment="CENTER" spacing="20" prefWidth="350" style="-fx-background-color: rgba(255,255,255,0.95);">
                    <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="🔐 Accès Privé" />
                    <Separator />
                    <VBox spacing="10">
                        <Label text="Identifiant Email" style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                        <TextField fx:id="txtLoginEmail" promptText="votre@email.com" styleClass="admin-form-input" />
                    </VBox>
                    <Button onAction="#handleLogin" styleClass="admin-btn-primary" text="Se Connecter" maxWidth="Infinity" style="-fx-padding: 12;" />
                    <Label fx:id="lblError" styleClass="error-message-label" text="" visible="false" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Dashboard Section (Hidden by default) -->
        <VBox fx:id="dashboardSection" spacing="30" style="-fx-padding: 50;" visible="false">
            <HBox spacing="30" alignment="CENTER_LEFT">
                <VBox spacing="10" styleClass="glass-card" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.95); -fx-padding: 30;">
                    <Label style="-fx-font-size: 18; -fx-text-fill: #7f8c8d;" text="Bienvenue dans votre espace," />
                    <Label fx:id="lblPartnerName" style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" text="Nom du Partenaire" />
                    <Label fx:id="lblPartnerInfo" style="-fx-font-size: 16; -fx-text-fill: #34495e;" text="Type | Email | Téléphone" />
                </VBox>
                
                <!-- API 1: Weather Widget -->
                <VBox alignment="CENTER" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #2d5a27, #1b4332); -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 15, 0, 0, 5);" prefWidth="280">
                    <Label text="🌤 Météo Agricole" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold; -fx-font-size: 16;" />
                    <Separator opacity="0.3" maxWidth="150" />
                    <Label fx:id="lblWeather" text="24 °C" style="-fx-text-fill: white; -fx-font-size: 36; -fx-font-weight: bold;" />
                    <Label text="Tunis, Tunisie" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;" />
                </VBox>

                <!-- API 2: AI Recommendations -->
                <VBox fx:id="aiContainer" spacing="12" styleClass="glass-card" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(to right, rgba(255,255,255,0.9), rgba(232, 245, 233, 0.95)); -fx-padding: 20; -fx-border-color: #2ecc71; -fx-border-width: 0 0 0 5;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🤖 Firmetna AI Insights" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1b4332;" />
                        <Label text="BETA" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 10; -fx-padding: 2 6; -fx-background-radius: 10;" />
                    </HBox>
                    <Label text="Partenaires recommandés pour optimiser votre activité :" style="-fx-font-size: 13; -fx-text-fill: #7f8c8d;" />
                    <VBox spacing="8">
                        <Label fx:id="lblAiRec1" style="-fx-text-fill: #2d3436; -fx-font-weight: bold; -fx-font-size: 14;" text="✨ Recommandation 1" />
                        <Label fx:id="lblAiRec2" style="-fx-text-fill: #2d3436; -fx-font-weight: bold; -fx-font-size: 14;" text="✨ Recommandation 2" />
                        <Label fx:id="lblAiRec3" style="-fx-text-fill: #2d3436; -fx-font-weight: bold; -fx-font-size: 14;" text="✨ Recommandation 3" />
                    </VBox>
                </VBox>
            </HBox>

            <VBox styleClass="glass-card" spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.95); -fx-padding: 30;">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="dashboard-title" text="📑 Mes Contrats &amp; Offres" style="-fx-font-size: 26;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 30; -fx-padding: 10 25; -fx-cursor: hand;" text="🚪 Déconnexion" />
                </HBox>
                
                <TableView fx:id="tableContracts" VBox.vgrow="ALWAYS" styleClass="admin-table">
                    <columns>
                        <TableColumn fx:id="colTitle" prefWidth="250.0" text="Titre du Contrat" />
                        <TableColumn fx:id="colValue" prefWidth="120.0" text="Valeur (TND)" />
                        <TableColumn fx:id="colStartDate" prefWidth="120.0" text="Date Début" />
                        <TableColumn fx:id="colEndDate" prefWidth="120.0" text="Date Fin" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Statut" />
                        <TableColumn fx:id="colTimeLeft" prefWidth="250.0" text="Temps Restant" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </StackPane>
    </VBox>
</StackPane>
