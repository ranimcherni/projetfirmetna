<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="800.0" prefWidth="1280.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontPartnerController">
    <children>
        <!-- Background Layer -->
        <VBox styleClass="front-root-bg" />
        <VBox mouseTransparent="true" styleClass="front-bg-overlay" />

        <VBox spacing="0">
            <children>
                <!-- FULL NAVIGATION BAR -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 ACCUEIL" />
                                <MenuButton styleClass="nav-item-dropdown" text="📦 PRODUITS">
                                    <items>
                                        <MenuItem onAction="#handleProduits" text="Tous les produits" />
                                        <MenuItem onAction="#handleProduitsVegetaux" text="Végétaux" />
                                        <MenuItem onAction="#handleProduitsAnimaux" text="Animaux" />
                                    </items>
                                </MenuButton>
                                <Button onAction="#handleEvenements" styleClass="nav-item" text="📅 ÉVÉNEMENTS" />
                                <Button onAction="#handleForum" styleClass="nav-item" text="💬 FORUM" />
                                <Button onAction="#handleDons" styleClass="nav-item" text="❤ DONS" />
                                <Button onAction="#handlePartenariats" styleClass="nav-item" text="🤝 PARTENARIATS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />
                        
                        <Button onAction="#handleGoBack" styleClass="nav-profile-btn" text="Retour" />
                    </children>
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">
                    <children>
                        <!-- PUBLIC SECTION (Login + Table) -->
                        <ScrollPane fx:id="publicSection" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                            <content>
                                <VBox alignment="TOP_CENTER" spacing="40.0" style="-fx-padding: 60 100;">
                                    <children>
                                        <!-- Big Slogan (NOW GREEN AND CLEAR) -->
                                        <VBox alignment="CENTER" spacing="10">
                                            <children>
                                                <Label style="-fx-font-size: 42; -fx-font-weight: bold; -fx-text-fill: #1b4332; -fx-effect: dropshadow(three-pass-box, rgba(255,255,255,0.8), 5, 0, 0, 0);" text="Développons ensemble l'agriculture de demain" />
                                                <Label style="-fx-font-size: 20; -fx-text-fill: #2d5a27; -fx-font-style: italic;" text="Rejoignez les leaders de l'agritech en Tunisie" />
                                            </children>
                                        </VBox>

                                        <HBox spacing="40.0" alignment="CENTER">
                                            <children>
                                                <!-- Left: Partners Table -->
                                                <VBox spacing="20" styleClass="glass-card" style="-fx-padding: 30; -fx-pref-width: 750;">
                                                    <children>
                                                        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Nos Partenaires de Confiance" />
                                                        <TableView fx:id="tablePublicPartners" prefHeight="400.0" styleClass="modern-table">
                                                            <columns>
                                                                <TableColumn fx:id="colPublicName" prefWidth="250.0" text="Nom du Partenaire" />
                                                                <TableColumn fx:id="colPublicType" prefWidth="150.0" text="Type" />
                                                                <TableColumn fx:id="colPublicAddress" prefWidth="300.0" text="Adresse" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                    </children>
                                                </VBox>

                                                <!-- Right: Private Access -->
                                                <VBox spacing="25" styleClass="glass-card" style="-fx-padding: 40; -fx-pref-width: 350;">
                                                    <children>
                                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                                            <Label text="🔐" style="-fx-font-size: 24;" />
                                                            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Accès Privé" />
                                                        </HBox>
                                                        <Separator />
                                                        <VBox spacing="10">
                                                            <children>
                                                                <Label text="Identifiant Email" style="-fx-font-weight: bold; -fx-text-fill: #4b635a;" />
                                                                <TextField fx:id="txtLoginEmail" promptText="votre@email.com" styleClass="text-field-custom" />
                                                            </children>
                                                        </VBox>
                                                        <Button onAction="#handleLogin" maxWidth="1.7976931348623157E308" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 10; -fx-cursor: hand;" text="Se Connecter" />
                                                        <Label fx:id="lblError" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;" visible="false" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- DASHBOARD SECTION -->
                        <ScrollPane fx:id="dashboardSection" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" visible="false">
                            <content>
                                <VBox spacing="35.0" style="-fx-padding: 50 80;">
                                    <children>
                                        <!-- Top Cards -->
                                        <HBox spacing="25.0">
                                            <children>
                                                <!-- Card 1: Welcome -->
                                                <VBox spacing="10.0" styleClass="glass-card" HBox.hgrow="ALWAYS" style="-fx-padding: 30; -fx-background-color: rgba(45, 90, 39, 0.7); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.3); -fx-border-radius: 20;">
                                                    <children>
                                                        <Label style="-fx-font-size: 18; -fx-text-fill: white;" text="Bienvenue dans votre espace," />
                                                        <Label fx:id="lblPartnerName" style="-fx-font-size: 38; -fx-font-weight: bold; -fx-text-fill: white;" text="AgriBio Tunisie" />
                                                        <Label fx:id="lblPartnerInfo" style="-fx-font-size: 16; -fx-text-fill: rgba(255,255,255,0.8);" text="Supplier | contact@agribio.tn | 22334455" />
                                                    </children>
                                                </VBox>

                                                <!-- Card 2: Weather -->
                                                <VBox alignment="CENTER" spacing="12.0" styleClass="glass-card" prefWidth="280.0" style="-fx-background-color: rgba(45, 90, 39, 0.1); -fx-border-color: rgba(45, 90, 39, 0.3); -fx-border-radius: 20; -fx-padding: 20;">
                                                    <children>
                                                        <HBox alignment="CENTER" spacing="8">
                                                            <Label text="🌤" style="-fx-font-size: 18;" />
                                                            <Label text="Météo Agricole" style="-fx-text-fill: #1b4332; -fx-font-weight: bold; -fx-font-size: 15;" />
                                                        </HBox>
                                                        <Separator maxWidth="100" />
                                                        <Label fx:id="lblWeather" style="-fx-text-fill: #1b4332; -fx-font-size: 38; -fx-font-weight: bold;" text="20.2 °C" />
                                                        <Label style="-fx-text-fill: #4b635a;" text="Tunis, Tunisie" />
                                                    </children>
                                                </VBox>

                                                <!-- Card 3: AI Insights -->
                                                <VBox spacing="12.0" styleClass="glass-card" prefWidth="480.0" style="-fx-padding: 20; -fx-background-color: rgba(45, 90, 39, 0.7); -fx-background-radius: 20; -fx-border-color: rgba(255, 255, 255, 0.3); -fx-border-radius: 20;">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                                            <children>
                                                                <Label text="🤖" style="-fx-font-size: 20;" />
                                                                <Label text="Firmetna AI Insights" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: white;" />
                                                                <Label text="BETA" style="-fx-background-color: #ffffff; -fx-text-fill: #2d5a27; -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 2 6; -fx-background-radius: 10;" />
                                                            </children>
                                                        </HBox>
                                                        <Label text="Partenaires recommandés pour optimiser votre activité :" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;" />
                                                        <VBox fx:id="vboxAIInsights" spacing="8" style="-fx-padding: 5 0 0 10;">
                                                            <!-- Recommandations ajoutées par le contrôleur -->
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Contracts Table Container -->
                                        <VBox spacing="0" styleClass="glass-card" style="-fx-padding: 0; -fx-background-color: white;">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 20 30; -fx-background-color: rgba(0,0,0,0.02);">
                                                    <children>
                                                        <Label text="📓" style="-fx-font-size: 24;" />
                                                        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Mes Contrats &amp; Offres" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 20; -fx-cursor: hand;" text="🚪 Déconnexion" />
                                                    </children>
                                                </HBox>
                                                <VBox style="-fx-padding: 20 30 30 30;">
                                                    <children>
                                                        <TableView fx:id="tableContracts" prefHeight="400.0" styleClass="modern-table">
                                                            <columns>
                                                                <TableColumn fx:id="colTitle" prefWidth="300.0" text="Titre du Contrat" />
                                                                <TableColumn fx:id="colValue" prefWidth="150.0" text="Valeur (TND)" />
                                                                <TableColumn fx:id="colStartDate" prefWidth="150.0" text="Date Début" />
                                                                <TableColumn fx:id="colEndDate" prefWidth="150.0" text="Date Fin" />
                                                                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Statut" />
                                                                <TableColumn fx:id="colTimeLeft" prefWidth="250.0" text="Temps Restant" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>
            </children>
        </VBox>
    </children>
</StackPane>
