<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontController">
    <children>
        <!-- Background Layer via CSS class -->
        <VBox styleClass="front-root-bg" />
        
        <!-- Light Green Overlay for Theme Consistency -->
        <VBox mouseTransparent="true" styleClass="front-bg-overlay" />
        


        <!-- Main Content Overlay -->
        <VBox spacing="60">
            <children>
                <!-- Refined Green Navbar -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 ACCUEIL" />
                                <MenuButton styleClass="nav-item-dropdown" text="📦 PRODUITS">
                                    <items>
                                        <MenuItem text="Fruits" />
                                        <MenuItem text="Légumes" />
                                    </items>
                                </MenuButton>
                                <Button onAction="#handleEvenements" styleClass="nav-item" text="📅 ÉVÉNEMENTS" />
                                <Button onAction="#handleForum" styleClass="nav-item" text="💬 FORUM" />
                                <Button onAction="#handleNotifications" styleClass="nav-item" text="🔔 NOTIFICATIONS" />
                                <Button onAction="#handleDons" styleClass="nav-item" text="❤ DONS" />
                                <Button onAction="#handlePartenariats" styleClass="nav-item" text="🤝 PARTENARIATS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                <MenuItem text="Mes Publications" />
                                <MenuItem text="Mon Panier" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleLogout" text="Deconnexion" style="-fx-text-fill: #e74c3c;" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <!-- Balanced Hero Section -->
                <HBox alignment="CENTER" spacing="80" VBox.vgrow="ALWAYS" style="-fx-padding: 0 100 0 100;">
                    <children>
                        <!-- LEFT: HERO TEXT -->
                        <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="welcomeLabel" styleClass="greeting-label" text="Bonjour, [Prénom]" />
                                
                                <VBox spacing="5">
                                    <children>
                                        <Label styleClass="slogan-fr" text="Firmetna - Produits fermiers frais et de qualité" />
                                        <Label styleClass="slogan-ar" text="منتجات زراعية طازجة وعالية الجودة" />
                                    </children>
                                </VBox>
                                
                                <Label styleClass="greeting-subtitle" text="Prêt à gérer votre ferme aujourd'hui ?" />
                                
                                <HBox spacing="15" style="-fx-padding: 20 0 0 0;">
                                    <children>
                                        <Button onAction="#handleAccueil" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 15 35; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;" text="Découvrir nos Produits" />
                                        <Button onAction="#handleForum" style="-fx-background-color: transparent; -fx-border-color: #27ae60; -fx-border-radius: 30; -fx-text-fill: #27ae60; -fx-padding: 15 35; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;" text="Le Forum" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- RIGHT: QUICK STATS GRID (MINIMALIST) -->
                        <VBox alignment="CENTER" spacing="20" styleClass="stats-container">
                            <children>
                                <!-- Stat 1: Produits -->
                                <HBox styleClass="stat-item">
                                    <children>
                                        <VBox styleClass="stat-icon-bg">
                                            <Label text="📦" style="-fx-font-size: 22;" />
                                        </VBox>
                                        <VBox>
                                            <children>
                                                <Label styleClass="stat-value" text="30+" />
                                                <Label styleClass="stat-label" text="Produits Bio" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Stat 2: Evenements -->
                                <HBox styleClass="stat-item">
                                    <children>
                                        <VBox styleClass="stat-icon-bg">
                                            <Label text="🗓️" style="-fx-font-size: 22;" />
                                        </VBox>
                                        <VBox>
                                            <children>
                                                <Label styleClass="stat-value" text="12" />
                                                <Label styleClass="stat-label" text="Événements" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Stat 3: Partenariats -->
                                <HBox styleClass="stat-item">
                                    <children>
                                        <VBox styleClass="stat-icon-bg">
                                            <Label text="🤝" style="-fx-font-size: 22;" />
                                        </VBox>
                                        <VBox>
                                            <children>
                                                <Label styleClass="stat-value" text="50" />
                                                <Label styleClass="stat-label" text="Partenaires" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
