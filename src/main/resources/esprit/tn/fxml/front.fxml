<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontController">
    <children>
        <!-- Background Layer via CSS class -->
        <VBox styleClass="front-root-bg" />
        
        <!-- Light Green Overlay for Theme Consistency -->
        <VBox mouseTransparent="true" styleClass="front-bg-overlay" />
        


        <!-- Main Content Overlay -->
        <VBox spacing="60">
            <children>
                <!-- Refined Green Navbar -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 ACCUEIL" />
                                <MenuButton styleClass="nav-item-dropdown" text="📦 PRODUITS">
                                    <items>
                                        <MenuItem onAction="#handleProduits" text="Tous les produits" />
                                        <MenuItem onAction="#handleProduitsVegetaux" text="Végétaux" />
                                        <MenuItem onAction="#handleProduitsAnimaux" text="Animaux" />
                                    </items>
                                </MenuButton>
                                <Button onAction="#handleEvenements" styleClass="nav-item" text="📅 ÉVÉNEMENTS" />
                                <Button onAction="#handleForum" styleClass="nav-item" text="💬 FORUM" />
                                <Button onAction="#handleDons" styleClass="nav-item" text="❤ DONS" />
                                <Button onAction="#handlePartenariats" styleClass="nav-item" text="🤝 PARTENARIATS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                <MenuItem text="Mes Publications" />
                                <MenuItem text="Mon Panier" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleLogout" text="Deconnexion" style="-fx-text-fill: #e74c3c;" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <!-- Balanced Hero Section -->
                <VBox alignment="CENTER_LEFT" spacing="40" VBox.vgrow="ALWAYS" style="-fx-padding: 0 100 0 100;">
                    <children>
                        <VBox spacing="15">
                            <children>
                                <Label fx:id="welcomeLabel" styleClass="greeting-label" text="Bonjour, [Prénom]" />
                                
                                <VBox spacing="5">
                                    <children>
                                        <Label styleClass="slogan-fr" text="Firmetna - Produits fermiers frais et de qualité" />
                                        <Label styleClass="slogan-ar" text="منتجات زراعية طازجة وعالية الجودة" />
                                    </children>
                                </VBox>
                                
                                <Label styleClass="greeting-subtitle" text="Prêt à gérer votre ferme aujourd'hui ?" />
                                
                                <HBox spacing="15" style="-fx-padding: 20 0 0 0;">
                                    <children>
                                        <Button onAction="#handleProduits" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 15 35; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;" text="Découvrir nos Produits" />
                                        <Button onAction="#handleForum" style="-fx-background-color: transparent; -fx-border-color: #2d5a27; -fx-border-radius: 30; -fx-text-fill: #2d5a27; -fx-padding: 15 35; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;" text="Le Forum" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- NEW HORIZONTAL STATS BAR -->
                        <HBox spacing="60" styleClass="stats-bar-modern" maxWidth="850">
                            <children>
                                <!-- Stat 1: Produits -->
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <Label text="📦" styleClass="stat-badge-icon" />
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="stat-badge-value" text="30+" />
                                                <Label styleClass="stat-badge-label" text="Produits Bio" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;" />

                                <!-- Stat 2: Evenements -->
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <Label text="📅" styleClass="stat-badge-icon" />
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="stat-badge-value" text="12" />
                                                <Label styleClass="stat-badge-label" text="Événements" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;" />

                                <!-- Stat 3: Partenariats -->
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <Label text="🤝" styleClass="stat-badge-icon" />
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="stat-badge-value" text="50" />
                                                <Label styleClass="stat-badge-label" text="Partenaires" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
        <!-- ================= CHATBOT LAYER ================= -->
        <AnchorPane pickOnBounds="false">
            <children>
                <!-- CHAT WINDOW -->
                <AnchorPane fx:id="chatbotContainer"
                            prefWidth="300.0" prefHeight="400.0"
                            visible="false" managed="false"
                            layoutX="850.0" layoutY="300.0"
                            style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #eee; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 6);">
                    <children>
                        <HBox fx:id="chatHeader" prefWidth="300.0" prefHeight="50.0" alignment="CENTER_LEFT" style="-fx-background-color: #f9f9f9; -fx-background-radius: 20 20 0 0; -fx-padding: 0 15;">
                            <children>
                                <Label text="Assistant Firmetna" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="✖" onAction="#toggleChatbot" style="-fx-background-color: transparent; -fx-text-fill: #999; -fx-font-size: 16; -fx-cursor: hand;" />
                            </children>
                        </HBox>
                        <ScrollPane fx:id="chatScrollPane" layoutY="50.0" prefWidth="300.0" prefHeight="290.0" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background: white; -fx-background-color: white; -fx-border-color: transparent;">
                            <content>
                                <VBox fx:id="chatMessages" spacing="10" style="-fx-padding: 15; -fx-background-color: white;" prefWidth="285.0" />
                            </content>
                        </ScrollPane>
                        <HBox layoutX="10.0" layoutY="350.0" prefWidth="280.0" spacing="10" alignment="CENTER">
                            <children>
                                <TextField fx:id="chatInput" onAction="#handleSendChat" promptText="Écrivez votre message..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-border-color: #ddd; -fx-border-radius: 20;" />
                                <Button text="➤" onAction="#handleSendChat" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-cursor: hand;" />
                            </children>
                        </HBox>
                    </children>
                </AnchorPane>

                <!-- FLOAT BUTTON -->
                <Button fx:id="chatbotToggleButton"
                        text="💬"
                        onAction="#toggleChatbot"
                        layoutX="900.0" layoutY="550.0"
                        style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 60; -fx-min-height: 60; -fx-font-size: 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
