<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontController">
    <children>
        <!-- Background Layer via CSS class -->
        <VBox styleClass="front-root-bg" />
        
        <!-- Light Green Overlay for Theme Consistency -->
        <VBox mouseTransparent="true" styleClass="front-bg-overlay" />
        


        <!-- Main Content Overlay -->
        <VBox spacing="60">
            <children>
                <!-- Refined Green Navbar -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 ACCUEIL" />
                                <MenuButton styleClass="nav-item-dropdown" text="📦 PRODUITS">
                                    <items>
                                        <MenuItem onAction="#handleProduits" text="Tous les produits" />
                                        <MenuItem onAction="#handleProduitsVegetaux" text="Végétaux" />
                                        <MenuItem onAction="#handleProduitsAnimaux" text="Animaux" />
                                    </items>
                                </MenuButton>
                                <Button onAction="#handleEvenements" styleClass="nav-item" text="📅 ÉVÉNEMENTS" />
                                <Button onAction="#handleForum" styleClass="nav-item" text="💬 FORUM" />
                                <Button onAction="#handleDons" styleClass="nav-item" text="❤ DONS" />
                                <Button onAction="#handlePartenariats" styleClass="nav-item" text="🤝 PARTENARIATS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleLogout" style="-fx-text-fill: #e74c3c;" text="Deconnexion" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <!-- Balanced Hero Section -->
                <VBox alignment="CENTER_LEFT" spacing="40" VBox.vgrow="ALWAYS" style="-fx-padding: 0 100 0 100;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="50">
                            <children>
                                <VBox spacing="15">
                                    <children>
                                        <Label fx:id="welcomeLabel" styleClass="greeting-label" text="Bonjour, [Prénom]" />
                                        
                                        <VBox spacing="5">
                                            <children>
                                                <Label styleClass="slogan-fr" text="Firmetna - Produits fermiers frais et de qualité" />
                                                <Label styleClass="slogan-ar" text="منتجات زراعية طازجة وعالية الجودة" />
                                            </children>
                                        </VBox>
                                        
                                        <Label styleClass="greeting-subtitle" text="Prêt à gérer votre ferme aujourd'hui ?" />
                                        
                                        <HBox spacing="15" style="-fx-padding: 20 0 0 0;">
                                            <children>
                                                <Button onAction="#handleProduits" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 15 35; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;" text="Découvrir nos Produits" />
                                                <Button onAction="#handleForum" style="-fx-background-color: transparent; -fx-border-color: #2d5a27; -fx-border-radius: 30; -fx-text-fill: #2d5a27; -fx-padding: 15 35; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;" text="Le Forum" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <!-- EVOLUTIVE PLANT CARD -->
                                <VBox fx:id="plantCard" spacing="15" styleClass="plant-card" prefWidth="320">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="15">
                                            <children>
                                                <ImageView fx:id="imgPlant" fitHeight="70" fitWidth="70" preserveRatio="true">
                                                    <!-- Image set by controller -->
                                                </ImageView>
                                                <VBox spacing="2">
                                                    <children>
                                                        <Label fx:id="lblPlantLevel" styleClass="plant-level-label" text="Stade : Graine" />
                                                        <Label fx:id="lblPlantStatus" text="En pleine croissance..." style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 12;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        
                                        <VBox spacing="8">
                                            <children>
                                                <ProgressBar fx:id="progressPlant" progress="0.2" maxWidth="Infinity" styleClass="plant-progress" />
                                                <Label fx:id="lblPlantHint" styleClass="plant-hint-label" text="Continuez vos activités pour voir votre plante grandir !" wrapText="true" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- NEW HORIZONTAL STATS BAR -->
                        <HBox spacing="60" styleClass="stats-bar-modern" maxWidth="850">
                            <children>
                                <!-- Stat 1: Produits -->
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <Label text="📦" styleClass="stat-badge-icon" />
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="lblTotalProducts" styleClass="stat-badge-value" text="30+" />
                                                <Label styleClass="stat-badge-label" text="Produits Bio" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;" />

                                <!-- Stat 2: Evenements -->
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <Label text="📅" styleClass="stat-badge-icon" />
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="lblTotalEvents" styleClass="stat-badge-value" text="12" />
                                                <Label styleClass="stat-badge-label" text="Événements" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;" />

                                <!-- Stat 3: Partenariats -->
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <Label text="🤝" styleClass="stat-badge-icon" />
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="lblTotalPartners" styleClass="stat-badge-value" text="50" />
                                                <Label styleClass="stat-badge-label" text="Partenaires" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
        <!-- ================= CHATBOT LAYER ================= -->
        <AnchorPane pickOnBounds="false">
            <children>
                <!-- (Old chatbot removed to use new unified float button) -->
            </children>
        </AnchorPane>
        <!-- FLOAT BUTTON CHATBOT -->
        <AnchorPane pickOnBounds="false">
            <children>
                <Button onAction="#handleOpenChatbot" styleClass="chatbot-float-btn" text="🤖" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
