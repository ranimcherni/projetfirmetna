<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontEvenementsController">
    <children>
        <VBox styleClass="front-root-bg" />
        <VBox mouseTransparent="true" styleClass="front-bg-overlay" />

        <VBox spacing="24" style="-fx-padding: 0 0 40 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 ACCUEIL" />
                                <Button styleClass="nav-item" text="📅 ÉVÉNEMENTS" disable="true" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleLogout" text="Deconnexion" style="-fx-text-fill: #e74c3c;" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <VBox spacing="16" VBox.vgrow="ALWAYS" style="-fx-padding: 0 40 0 40;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10 0 10 0;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-form-input" HBox.hgrow="ALWAYS" maxWidth="400">
                                    <children>
                                        <Label text="🔍" style="-fx-font-size: 16;" />
                                        <TextField fx:id="searchField" promptText="Rechercher un événement..." style="-fx-background-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                        <Label text="Trier par :" style="-fx-text-fill: #636e72; -fx-font-weight: bold;" />
                                        <ComboBox fx:id="sortCombo" prefWidth="180" styleClass="admin-form-combo" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
                            <content>
                                <FlowPane fx:id="eventContainer" hgap="30" vgap="30" style="-fx-padding: 10 0 40 0;">
                                    <!-- Dynamic cards will be added here -->
                                </FlowPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
