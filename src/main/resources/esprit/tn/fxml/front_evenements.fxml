<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontEvenementsController">
    <children>
        <!-- Background Layer -->
        <VBox styleClass="front-root-bg" />
        <VBox mouseTransparent="true" styleClass="front-bg-overlay" />

        <VBox spacing="0">
            <children>
                <!-- NAVIGATION BAR (TOP) -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 ACCUEIL" />
                                <MenuButton styleClass="nav-item-dropdown" text="📦 PRODUITS">
                                    <items>
                                        <MenuItem onAction="#handleProduits" text="Tous les produits" />
                                        <MenuItem onAction="#handleProduitsVegetaux" text="Végétaux" />
                                        <MenuItem onAction="#handleProduitsAnimaux" text="Animaux" />
                                    </items>
                                </MenuButton>
                                <Button styleClass="nav-item-active" text="📅 ÉVÉNEMENTS" />
                                <Button onAction="#handleForum" styleClass="nav-item" text="💬 FORUM" />
                                <Button onAction="#handleDons" styleClass="nav-item" text="❤ DONS" />
                                <Button onAction="#handlePartenariats" styleClass="nav-item" text="🤝 PARTENARIATS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleLogout" style="-fx-text-fill: #e74c3c;" text="Deconnexion" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <!-- MAIN CONTENT -->
                <VBox spacing="25" VBox.vgrow="ALWAYS" style="-fx-padding: 30 50 50 50;">
                    <children>
                        <!-- HEADER SECTION -->
                        <HBox alignment="CENTER_LEFT" styleClass="glass-card" style="-fx-padding: 25;">
                            <children>
                                <VBox spacing="5">
                                    <children>
                                        <Label text="Événements Agricoles" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                        <Label text="Découvrez et participez aux rassemblements de notre communauté" style="-fx-font-size: 15; -fx-text-fill: #666;" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <children>
                                        <TextField fx:id="searchField" prefWidth="300.0" promptText="🔍 Rechercher un événement..." styleClass="search-bar-modern" />
                                        <ComboBox fx:id="sortCombo" prefWidth="180.0" styleClass="form-input-modern" promptText="Trier par" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- EVENTS GRID -->
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                            <content>
                                <FlowPane fx:id="eventContainer" hgap="30" vgap="30" style="-fx-padding: 10 0 40 0;">
                                    <!-- Dynamic event cards -->
                                </FlowPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
        <!-- FLOAT BUTTON CHATBOT -->
        <AnchorPane pickOnBounds="false">
            <children>
                <Button onAction="#handleOpenChatbot" styleClass="chatbot-float-btn" text="🤖" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
