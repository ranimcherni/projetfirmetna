<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: white;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminDonationsOffresController">
    <children>
        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5">
                    <children>
                        <Label text="Gestion des Offres de Dons" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                        <Label text="Suivi et administration des dons de la communauté" style="-fx-text-fill: #636e72; -fx-font-size: 13;" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleStatistics" styleClass="admin-btn-secondary" text="🏆 Classement Donateurs" />
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="25">
                    <children>
                        <!-- FORM SECTION -->
                        <VBox spacing="20" styleClass="admin-card" style="-fx-padding: 25; -fx-background-color: #f8f9fa; -fx-background-radius: 15;">
                            <children>
                                <Label text="Modifier / Ajouter une Offre" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                
                                <GridPane hgap="20" vgap="15">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="Catégorie du Produit" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="categorieField" promptText="Ex: Semences, Engrais..." styleClass="admin-form-field" />
                                                <Label fx:id="errorCategorie" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="8" GridPane.columnIndex="1">
                                            <children>
                                                <Label text="Téléphone de Contact" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="telephoneField" promptText="Votre numéro" styleClass="admin-form-field" />
                                                <Label fx:id="errorTelephone" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="8" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Quantité Disponible" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="quantiteField" promptText="Nombre d'unités" styleClass="admin-form-field" />
                                                <Label fx:id="errorQuantite" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Lien de la Photo" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="photoField" promptText="URL de l'image" styleClass="admin-form-field" />
                                                <Label fx:id="errorPhoto" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <VBox spacing="8">
                                    <children>
                                        <Label text="Description de l'Offre" style="-fx-font-weight: bold;" />
                                        <TextArea fx:id="descriptionField" prefHeight="80.0" promptText="Décrivez votre don..." styleClass="admin-form-field" wrapText="true" />
                                        <Label fx:id="errorDescription" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                    </children>
                                </VBox>

                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button onAction="#handleClear" text="Vider" styleClass="admin-btn-outline" />
                                        <Button onAction="#handleAdd" text="Ajouter" styleClass="admin-btn-primary" />
                                        <Button onAction="#handleUpdate" text="Modifier" styleClass="admin-btn-info" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- TABLE SECTION -->
                        <VBox spacing="15" styleClass="admin-card" style="-fx-padding: 25; -fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #eee; -fx-border-radius: 15;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <children>
                                        <Label text="Liste des Offres" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="searchField" prefWidth="200.0" promptText="🔍 Rechercher..." styleClass="admin-search-bar" />
                                        <ComboBox fx:id="sortCombo" prefWidth="130.0" />
                                        <CheckBox fx:id="stockOnlyCheck" text="En stock" />
                                    </children>
                                </HBox>

                                <TableView fx:id="offreTable" prefHeight="300.0" styleClass="admin-table">
                                    <columns>
                                        <TableColumn fx:id="colCategorie" prefWidth="150.0" text="Catégorie" />
                                        <TableColumn fx:id="colTelephone" prefWidth="120.0" text="Téléphone" />
                                        <TableColumn fx:id="colQuantite" prefWidth="100.0" text="Quantité" />
                                        <TableColumn fx:id="colDescription" prefWidth="350.0" text="Description" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                
                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Button onAction="#handleDelete" text="🗑 Supprimer" styleClass="admin-btn-danger" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
