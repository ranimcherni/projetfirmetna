<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-padding: 30;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminDonationsOffresController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox>
                    <Label text="Gestion Donations (Offres)" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                    <Label text="Ajout, modification et suppression des offres de dons" style="-fx-text-fill: #636e72; -fx-font-size: 13;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleAdd" prefHeight="40.0" styleClass="admin-btn-primary" text="+ Ajouter une offre" />
            </children>
        </HBox>

        <HBox spacing="20.0" style="-fx-padding: 0 0 10 0;">
            <children>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Formulaire Offre" styleClass="admin-stat-label" />
                    <Label text="Remplir les champs puis enregistrer" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;" />
                </VBox>
            </children>
        </HBox>

        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="searchField" prefHeight="42.0" promptText="Recherche dynamique produit (categorie/description...)" styleClass="admin-form-input" HBox.hgrow="ALWAYS" />
                <CheckBox fx:id="stockOnlyCheck" text="En stock uniquement" />
                <ComboBox fx:id="sortCombo" prefHeight="42.0" prefWidth="220.0" styleClass="admin-form-input" />
            </children>
        </HBox>

        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <children>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <TextField fx:id="telephoneField" prefHeight="42.0" promptText="Telephone" styleClass="admin-form-input" />
                    <Label fx:id="errorTelephone" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <TextField fx:id="categorieField" prefHeight="42.0" promptText="Categorie" styleClass="admin-form-input" />
                    <Label fx:id="errorCategorie" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <TextField fx:id="photoField" prefHeight="42.0" promptText="Photo (URL / fichier)" styleClass="admin-form-input" />
                    <Label fx:id="errorPhoto" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <TextField fx:id="quantiteField" prefHeight="42.0" promptText="Quantite" styleClass="admin-form-input" />
                    <Label fx:id="errorQuantite" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="2">
            <TextArea fx:id="descriptionField" prefRowCount="3" promptText="Description" styleClass="admin-form-input" />
            <Label fx:id="errorDescription" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
        </VBox>

        <HBox spacing="10.0">
            <children>
                <Button onAction="#handleUpdate" prefHeight="38.0" styleClass="admin-btn-primary" text="Modifier" />
                <Button onAction="#handleDelete" prefHeight="38.0" styleClass="admin-btn-secondary" text="Supprimer" />
                <Button onAction="#handleClear" prefHeight="38.0" styleClass="admin-btn-secondary" text="Vider" />
                <Button onAction="#handleStatistics" prefHeight="38.0" styleClass="admin-btn-primary" style="-fx-background-color: #0984e3;" text="🏆 Top Donateurs" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleOpenChatbot" prefHeight="38.0" styleClass="admin-btn-primary" style="-fx-background-color: #2d5a27;" text="🤖 Assistant IA" />
            </children>
        </HBox>

        <TableView fx:id="offreTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colTelephone" prefWidth="140.0" text="Telephone" />
                <TableColumn fx:id="colCategorie" prefWidth="170.0" text="Categorie" />
                <TableColumn fx:id="colDescription" prefWidth="320.0" text="Description" />
                <TableColumn fx:id="colQuantite" prefWidth="110.0" text="Quantite" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
