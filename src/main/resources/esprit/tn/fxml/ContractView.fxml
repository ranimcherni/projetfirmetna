<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #f5f6fa; -fx-padding: 30;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ContractController">
    
    <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Gestion des Contrats &amp; Offres" />

    <!-- Form Section -->
    <HBox spacing="20">
        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Partenaire:" />
                <ComboBox fx:id="cmbPartner" promptText="Sélectionner le partenaire" prefWidth="250.0" />
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Titre:" />
                <TextField fx:id="txtTitle" promptText="Titre du contrat" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Valeur (TND):" />
                <TextField fx:id="txtValue" promptText="Ex: 1500.50" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleConvertCurrency" text="🔄 Convertir EUR" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;" />
                <Label fx:id="lblEurValue" text="0.00 €" style="-fx-font-weight: bold; -fx-text-fill: #e67e22;" />
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Statut:" />
                <ComboBox fx:id="cmbStatus" promptText="Statut actuel" prefWidth="250.0" />
            </HBox>
        </VBox>
        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Date Début:" />
                <DatePicker fx:id="dpStartDate" prefWidth="200.0" />
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Date Fin:" />
                <DatePicker fx:id="dpEndDate" prefWidth="200.0" />
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label prefWidth="100.0" text="Durée estimée:" />
                <Label fx:id="lblDuration" text="0 jours" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;" />
            </HBox>
            <HBox spacing="15">
                <Label prefWidth="100.0" text="Description:" />
                <TextArea fx:id="txtDescription" prefHeight="60.0" promptText="Détails du contrat..." HBox.hgrow="ALWAYS" />
            </HBox>
            
            <!-- Buttons Section -->
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <padding>
                    <Insets top="5" />
                </padding>
                <Button onAction="#handleAdd" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Ajouter" />
                <Button onAction="#handleUpdate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" text="Modifier" />
                <Button onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Supprimer" />
                <Button onAction="#handleClear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" text="Vider" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Search and Actions Section -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="🔍 Rechercher par titre..." prefWidth="300.0" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleExportCSV" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold;" text="📥 Exporter CSV" />
    </HBox>

    <!-- Table Section -->
    <TableView fx:id="tableContracts" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colPartnerId" prefWidth="100.0" text="ID Partenaire" />
            <TableColumn fx:id="colTitle" prefWidth="150.0" text="Titre" />
            <TableColumn fx:id="colStartDate" prefWidth="100.0" text="Début" />
            <TableColumn fx:id="colEndDate" prefWidth="100.0" text="Fin" />
            <TableColumn fx:id="colValue" prefWidth="100.0" text="Valeur" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Statut" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
