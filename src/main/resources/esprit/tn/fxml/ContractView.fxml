<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="25.0" style="-fx-background-color: #f4f7f6; -fx-padding: 30;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ContractController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1b4332;" text="Gestion des Contrats &amp; Offres" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleExportCSV" style="-fx-background-color: #9b59b6; -fx-text-fill: white;" text="📥 Exporter en CSV" />
            </children>
        </HBox>

        <!-- Form Card -->
        <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <children>
                <HBox spacing="20.0">
                    <children>
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Partenaire &amp; Titre" />
                                <ComboBox fx:id="cmbPartner" maxWidth="1.7976931348623157E308" promptText="Choisir un partenaire" />
                                <TextField fx:id="txtTitle" promptText="Titre de l'offre / Contrat" styleClass="text-field-custom" />
                            </children>
                        </VBox>
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Détails Financiers &amp; Dates" />
                                <HBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="txtValue" promptText="Valeur (TND)" styleClass="text-field-custom" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleConvertCurrency" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="🔄" />
                                        <Label fx:id="lblEurValue" style="-fx-text-fill: #e67e22; -fx-font-weight: bold;" text="0.00 €">
                                 <padding>
                                    <Insets top="10.0" />
                                 </padding></Label>
                                    </children>
                                </HBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <DatePicker fx:id="dpStartDate" promptText="Début" HBox.hgrow="ALWAYS" />
                                        <DatePicker fx:id="dpEndDate" promptText="Fin" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <Label fx:id="lblDuration" style="-fx-text-fill: #2980b9;" text="Durée : 0 jours" />
                            </children>
                        </VBox>
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Statut &amp; Description" />
                                <ComboBox fx:id="cmbStatus" maxWidth="1.7976931348623157E308" promptText="Statut" />
                                <TextArea fx:id="txtDescription" prefHeight="60.0" promptText="Conditions et détails..." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button onAction="#handleClear" styleClass="btn-secondary" text="Réinitialiser" />
                        <Button onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Supprimer" />
                        <Button onAction="#handleUpdate" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Modifier" />
                        <Button onAction="#handleAdd" styleClass="btn-primary" text="Enregistrer Contrat" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="txtSearch" prefWidth="400.0" promptText="🔍 Rechercher par titre de contrat..." styleClass="text-field-custom" />
            </children>
        </HBox>

        <!-- Table -->
        <TableView fx:id="tableContracts" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colPartnerId" prefWidth="100.0" text="ID Partenaire" />
                <TableColumn fx:id="colTitle" prefWidth="250.0" text="Titre" />
                <TableColumn fx:id="colStartDate" prefWidth="120.0" text="Début" />
                <TableColumn fx:id="colEndDate" prefWidth="120.0" text="Fin" />
                <TableColumn fx:id="colValue" prefWidth="120.0" text="Valeur (TND)" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Statut" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
