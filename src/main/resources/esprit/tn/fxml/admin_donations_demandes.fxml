<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-padding: 30;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminDonationsDemandesController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox>
                    <Label text="Gestion Donations (Demandes)" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                    <Label text="Gestion des demandes reliees aux offres et utilisateurs" style="-fx-text-fill: #636e72; -fx-font-size: 13;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleAdd" prefHeight="40.0" styleClass="admin-btn-primary" text="+ Ajouter une demande" />
            </children>
        </HBox>

        <HBox spacing="20.0" style="-fx-padding: 0 0 10 0;">
            <children>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Formulaire Demande" styleClass="admin-stat-label" />
                    <Label text="Offre ID + User ID + Quantite + Statut" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;" />
                </VBox>
            </children>
        </HBox>

        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="searchField" prefHeight="42.0" promptText="Recherche dynamique par produit/statut..." styleClass="admin-form-input" HBox.hgrow="ALWAYS" />
                <CheckBox fx:id="stockOnlyCheck" text="Produit en stock uniquement" />
                <ComboBox fx:id="sortCombo" prefHeight="42.0" prefWidth="220.0" styleClass="admin-form-input" />
            </children>
        </HBox>

        <HBox spacing="12.0">
            <children>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <TextField fx:id="offreIdField" prefHeight="42.0" promptText="Offre ID" styleClass="admin-form-input" />
                    <Label fx:id="errorOffreId" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <TextField fx:id="userIdField" prefHeight="42.0" promptText="User ID" styleClass="admin-form-input" />
                    <Label fx:id="errorUserId" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <TextField fx:id="quantiteField" prefHeight="42.0" promptText="Quantite demandee" styleClass="admin-form-input" />
                    <Label fx:id="errorQuantite" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <TextField fx:id="statutField" prefHeight="42.0" promptText="Statut (ex: EN_ATTENTE)" styleClass="admin-form-input" />
                    <Label fx:id="errorStatut" textFill="RED" style="-fx-font-size: 11; -fx-font-weight: bold;" visible="false" managed="false"/>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="10.0">
            <children>
                <Button onAction="#handleUpdate" prefHeight="38.0" styleClass="admin-btn-primary" text="Modifier" />
                <Button onAction="#handleDelete" prefHeight="38.0" styleClass="admin-btn-secondary" text="Supprimer" />
                <Button onAction="#handleClear" prefHeight="38.0" styleClass="admin-btn-secondary" text="Vider" />
            </children>
        </HBox>

        <TableView fx:id="demandeTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colOffreId" prefWidth="90.0" text="Offre ID" />
                <TableColumn fx:id="colUserId" prefWidth="90.0" text="User ID" />
                <TableColumn fx:id="colQuantite" prefWidth="100.0" text="Qte demandee" />
                <TableColumn fx:id="colProduit" prefWidth="160.0" text="Produit" />
                <TableColumn fx:id="colStatut" prefWidth="150.0" text="Statut" />
                <TableColumn fx:id="colCreatedAt" prefWidth="220.0" text="Creee le" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
