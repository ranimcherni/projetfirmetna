<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30; -fx-background-color: white;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminDonationsDemandesController">
    <children>
        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5">
                    <children>
                        <Label text="Gestion des Demandes de Dons" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                        <Label text="Suivi et validation des demandes reliées aux offres et utilisateurs" style="-fx-text-fill: #636e72; -fx-font-size: 13;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="25">
                    <children>
                        <!-- FORM SECTION -->
                        <VBox spacing="20" styleClass="admin-card" style="-fx-padding: 25; -fx-background-color: #f8f9fa; -fx-background-radius: 15;">
                            <children>
                                <Label text="Modifier une Demande" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                
                                <GridPane hgap="20" vgap="15">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="8">
                                            <children>
                                                <Label text="Offre ID" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="offreIdField" promptText="ID de l'offre" styleClass="admin-form-field" />
                                                <Label fx:id="errorOffreId" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="8" GridPane.columnIndex="1">
                                            <children>
                                                <Label text="User ID" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="userIdField" promptText="ID de l'utilisateur" styleClass="admin-form-field" />
                                                <Label fx:id="errorUserId" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="8" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Quantité Demandée" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="quantiteField" promptText="Nombre d'unités" styleClass="admin-form-field" />
                                                <Label fx:id="errorQuantite" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <Label text="Statut" style="-fx-font-weight: bold;" />
                                                <TextField fx:id="statutField" promptText="ex: EN_ATTENTE" styleClass="admin-form-field" />
                                                <Label fx:id="errorStatut" managed="false" style="-fx-font-size: 11; -fx-text-fill: #e74c3c;" visible="false" />
                                            </children>
                                        </VBox>
                                    </children>
                                </GridPane>

                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button onAction="#handleClear" text="Vider" styleClass="admin-btn-outline" />
                                        <Button onAction="#handleUpdate" text="Modifier" styleClass="admin-btn-info" />
                                        <Button onAction="#handleDelete" text="Supprimer" styleClass="admin-btn-danger" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- TABLE SECTION -->
                        <VBox spacing="15" styleClass="admin-card" style="-fx-padding: 25; -fx-background-color: white; -fx-background-radius: 15; -fx-border-color: #eee; -fx-border-radius: 15;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <children>
                                        <Label text="Liste des Demandes" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="searchField" prefWidth="250.0" promptText="🔍 Rechercher..." styleClass="admin-search-bar" />
                                        <ComboBox fx:id="sortCombo" prefWidth="180.0" />
                                        <CheckBox fx:id="stockOnlyCheck" text="En stock" />
                                    </children>
                                </HBox>

                                <TableView fx:id="demandeTable" prefHeight="350.0" styleClass="admin-table">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                                        <TableColumn fx:id="colOffreId" prefWidth="100.0" text="Offre ID" />
                                        <TableColumn fx:id="colUserId" prefWidth="100.0" text="User ID" />
                                        <TableColumn fx:id="colProduit" prefWidth="200.0" text="Produit" />
                                        <TableColumn fx:id="colQuantite" prefWidth="120.0" text="Qte demandée" />
                                        <TableColumn fx:id="colStatut" prefWidth="150.0" text="Statut" />
                                        <TableColumn fx:id="colCreatedAt" prefWidth="200.0" text="Créée le" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
