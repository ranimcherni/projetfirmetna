<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<GridPane alignment="CENTER" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SignUpController">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints vgrow="ALWAYS" />
    </rowConstraints>

    <children>
        <!-- Left Side: Hero Section (Guaranteed 50%) -->
        <StackPane GridPane.columnIndex="0" styleClass="landscape-bg" maxHeight="Infinity">
            <VBox alignment="CENTER" spacing="40" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 60;">
                <!-- Logo Branding -->
                <ImageView fitHeight="150" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo1.png" />
                    </image>
                </ImageView>
                
                <VBox alignment="CENTER" spacing="25">
                    <Label text="Cultivez votre avenir avec nous" wrapText="true" textAlignment="CENTER"
                           style="-fx-text-fill: white; -fx-font-size: 42; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 0);" />
                    <Label text="Rejoignez la première plateforme agricole qui connecte producteurs, clients et volontaires." 
                           wrapText="true" textAlignment="CENTER" maxWidth="500"
                           style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-italic: true; -fx-line-spacing: 8;" />
                </VBox>
            </VBox>
        </StackPane>

        <!-- Right Side: Registration Form (Guaranteed 50%) -->
        <ScrollPane GridPane.columnIndex="1" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white;" maxHeight="Infinity">
            <VBox spacing="30" style="-fx-background-color: white;" alignment="TOP_CENTER">
                <padding>
                    <Insets top="50" right="80" bottom="50" left="80" />
                </padding>

                <VBox alignment="CENTER" spacing="12">
                    <ImageView fitHeight="60" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo1.png" />
                        </image>
                    </ImageView>
                    <Label text="CRÉER UN COMPTE" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1b4332;" />
                    <Label text="Bienvenue parmi nous !" style="-fx-text-fill: #636e72; -fx-font-size: 15;" />
                </VBox>

                <!-- Avatar Placeholder -->
                <VBox alignment="CENTER" style="-fx-padding: 10 0;">
                    <StackPane maxWidth="110">
                        <Circle radius="55" fill="#f1f2f6" stroke="#dcdde1" />
                        <ImageView fx:id="avatarImageView" fitHeight="110" fitWidth="110" preserveRatio="true">
                            <clip>
                                <Circle centerX="55" centerY="55" radius="55" />
                            </clip>
                        </ImageView>
                        <Label fx:id="avatarPlaceholder" text="👤" style="-fx-font-size: 45; -fx-text-fill: #b2bec3;" />
                        <Button onAction="#handleSelectAvatar" styleClass="avatar-icon-btn" StackPane.alignment="TOP_RIGHT">
                            <graphic><Label text="📷" style="-fx-font-size: 14;" /></graphic>
                        </Button>
                    </StackPane>
                </VBox>

                <!-- Form Fields (GridPane for perfect alignment) -->
                <GridPane hgap="25" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                    </columnConstraints>
                    
                    <children>
                        <!-- Nom & Prénom -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Nom" style="-fx-font-weight: bold;" />
                            <TextField fx:id="nomField" promptText="Ex: Cherni" minHeight="45" />
                            <Label fx:id="nomError" styleClass="error-message-label" text="Nom invalide" />
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Prénom" style="-fx-font-weight: bold;" />
                            <TextField fx:id="prenomField" promptText="Ex: Ranim" minHeight="45" />
                            <Label fx:id="prenomError" styleClass="error-message-label" text="Prénom invalide" />
                        </VBox>
    
                        <!-- Email -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                            <Label text="Email" style="-fx-font-weight: bold;" />
                            <TextField fx:id="emailField" promptText="votre@email.com" minHeight="45" />
                            <Label fx:id="emailError" styleClass="error-message-label" text="Email invalide" />
                        </VBox>
    
                        <!-- Téléphone & Type -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Téléphone (+216)" style="-fx-font-weight: bold;" />
                            <TextField fx:id="phoneField" text="+216" minHeight="45" />
                            <Label fx:id="phoneError" styleClass="error-message-label" text="Téléphone invalide" />
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Type de compte" style="-fx-font-weight: bold;" />
                            <ComboBox fx:id="roleCombo" prefWidth="Infinity" minHeight="45">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Agriculteur" />
                                        <String fx:value="Client" />
                                        <String fx:value="Donateur" />
                                    </FXCollections>
                                </items>
                                <value>
                                    <String fx:value="Agriculteur" />
                                </value>
                            </ComboBox>
                        </VBox>
    
                        <!-- Passwords -->
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                            <Label text="Mot de passe" style="-fx-font-weight: bold;" />
                            <PasswordField fx:id="passwordField" promptText="••••••••" minHeight="45" />
                            <Label fx:id="passwordError" styleClass="error-message-label" text="Mot de passe trop faible" />
                        </VBox>
                        <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                            <Label text="Confirmer le mot de passe" style="-fx-font-weight: bold;" />
                            <PasswordField fx:id="confirmPasswordField" promptText="••••••••" minHeight="45" />
                            <Label fx:id="confirmPasswordError" styleClass="error-message-label" text="Les mots de passe ne correspondent pas" />
                        </VBox>
                    </children>
                </GridPane>

                <Button text="S'inscrire" onAction="#handleSignUp" 
                        prefWidth="Infinity" style="-fx-background-color: #1b4332; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 15; -fx-background-radius: 10;" />

                <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10 0 0 0;">
                    <Label text="Déjà un compte ?" style="-fx-font-size: 14;" />
                    <Button text="Connectez-vous" onAction="#goToLogin" styleClass="link-button" style="-fx-text-fill: #1b4332; -fx-font-weight: bold; -fx-font-size: 14;" />
                </HBox>
            </VBox>
        </ScrollPane>
    </children>
</GridPane>
