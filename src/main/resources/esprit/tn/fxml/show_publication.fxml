<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ShowPublicationController">
    <children>
        <!-- Background Layer -->
        <VBox styleClass="front-root-bg" />

        <!-- Main Content Overlay -->
        <VBox spacing="0">
            <children>
                <!-- NAVIGATION BAR -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="🏠 Accueil" />
                                <MenuButton styleClass="nav-item-dropdown" text="📦 Produits">
                                    <items>
                                        <MenuItem text="Fruits" />
                                        <MenuItem text="Légumes" />
                                    </items>
                                </MenuButton>
                                <Button onAction="#handleEvenements" styleClass="nav-item" text="📅 Événements" />
                                <Button styleClass="nav-item-active" text="💬 Forum" />
                                <Button onAction="#handleDons" styleClass="nav-item" text="❤ Dons" />
                                <Button styleClass="nav-item" text="🤝 Partenariats" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleLogout" style="-fx-text-fill: #e74c3c;" text="Deconnexion" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <!-- Scrollable Content -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="30" style="-fx-padding: 40 60 40 60;">
                            <children>
                                <!-- Back Button and Lang Selector -->
                                <HBox spacing="20" alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="← Retour au Forum" onAction="#goBack" styleClass="btn-secondary" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-border-color: white;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="comboLanguage" promptText="Traduire vers..." style="-fx-background-radius: 20; -fx-padding: 5 15;" />
                                    </children>
                                </HBox>

                                <!-- Main Publication Card -->
                                <VBox spacing="25" styleClass="card" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 30; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 30, 0, 0, 15);">
                                    <children>
                                        <VBox spacing="10" alignment="CENTER_LEFT">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="20">
                                                    <children>
                                                        <Label fx:id="lblTitre" text="Titre..." styleClass="header-title" style="-fx-font-size: 28px; -fx-text-fill: #1b4332;" HBox.hgrow="ALWAYS"/>
                                                        <TextField fx:id="txtEditTitre" styleClass="search-box" visible="false" managed="false" HBox.hgrow="ALWAYS"/>
                                                        
                                                        <HBox spacing="10">
                                                            <children>
                                                                <Button fx:id="btnEdit" text="Editer" onAction="#toggleEditPublication" styleClass="btn-secondary" />
                                                                <Button fx:id="btnSave" text="Sauvegarder" onAction="#savePublicationUpdate" styleClass="btn-primary" style="-fx-background-color: #2ecc71;" visible="false" managed="false"/>
                                                                <Button fx:id="btnCancel" text="Annuler" onAction="#toggleEditPublication" styleClass="btn-secondary" visible="false" managed="false"/>
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="15" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label fx:id="lblType" styleClass="text-muted" style="-fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                                        <Label fx:id="lblDate" styleClass="text-muted" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <Separator style="-fx-opacity: 0.1;" />

                                        <StackPane fx:id="imageContainer" style="-fx-background-color: #f8f9fa; -fx-background-radius: 20; -fx-padding: 10;">
                                            <children>
                                                <ImageView fx:id="imgPublication" fitWidth="700.0" preserveRatio="true" smooth="true" />
                                            </children>
                                        </StackPane>

                                        <Button fx:id="btnOpenPdf" text="Ouvrir le document PDF 📄" onAction="#openPdf" styleClass="btn-secondary" style="-fx-border-color: #e74c3c; -fx-text-fill: #e74c3c;" visible="false" managed="false"/>

                                        <Label fx:id="lblContenu" text="Contenu..." wrapText="true" style="-fx-font-size: 16px; -fx-text-fill: #333; -fx-line-spacing: 5;" minHeight="100" alignment="TOP_LEFT"/>
                                        <Button fx:id="btnTranslateMain" text="Voir la traduction 🌍" onAction="#translateMainAction" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand; -fx-underline: true; -fx-font-size: 14px; -fx-padding: 0;"/>
                                        <TextArea fx:id="txtEditContenu" prefHeight="200" visible="false" managed="false" style="-fx-background-radius: 15;" />

                                        <HBox spacing="25" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                                            <children>
                                                <Button fx:id="btnLikePublication" text="👍 J'aime" onAction="#likePublication" styleClass="btn-like" />
                                                <Label fx:id="lblLikesPublication" text="0" styleClass="reaction-count" />
                                                <Button fx:id="btnDislikePublication" text="👎 Je n'aime pas" onAction="#dislikePublication" styleClass="btn-dislike" />
                                                <Label fx:id="lblDislikesPublication" text="0" styleClass="reaction-count" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Comments Section -->
                                <VBox spacing="20">
                                    <children>
                                        <Label text="Commentaires" styleClass="header-title" style="-fx-font-size: 24px; -fx-text-fill: white;" />
                                        <ListView fx:id="listCommentaires" minHeight="500" styleClass="list-view-forum" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 20;" />

                                        <VBox spacing="15" styleClass="card" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 20; -fx-padding: 25;">
                                            <children>
                                                <HBox spacing="15" alignment="CENTER">
                                                    <children>
                                                        <TextArea fx:id="txtNewComment" promptText="Apportez votre expertise..." prefHeight="80.0" HBox.hgrow="ALWAYS" style="-fx-background-radius: 15; -fx-padding: 10;" />
                                                        <Button fx:id="btnPostComment" text="Publier" onAction="#postComment" styleClass="btn-primary" prefHeight="80" prefWidth="120" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</StackPane>
