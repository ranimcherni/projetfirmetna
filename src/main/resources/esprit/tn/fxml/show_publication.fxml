<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ShowPublicationController"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../css/forum.css" styleClass="main-bg">

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" styleClass="main-bg"
                AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <content>
            <VBox spacing="30" style="-fx-padding: 40 60 40 60;">
        
                <!-- Header -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Button text="← Retour" onAction="#goBack" styleClass="btn-secondary"/>
                    <VBox>
                        <Label text="Détail de la Publication" styleClass="header-title"/>
                        <Label fx:id="lblDate" text="Date: ..." styleClass="text-muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="comboLanguage" promptText="Traduire vers..." styleClass="combo-box" style="-fx-font-size: 13px;"/>
                </HBox>
        
                <!-- Main Publication Content -->
                <VBox spacing="20" styleClass="card" VBox.vgrow="NEVER">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label fx:id="lblTitre" text="Titre..." styleClass="header-title-lg" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtEditTitre" styleClass="text-field-custom" visible="false" managed="false" HBox.hgrow="ALWAYS"/>
                        
                        <HBox spacing="10">
                            <Button fx:id="btnEdit" text="Editer" onAction="#toggleEditPublication" styleClass="btn-secondary"/>
                            <Button fx:id="btnSave" text="Sauvegarder" onAction="#savePublicationUpdate" styleClass="btn-success" visible="false" managed="false"/>
                            <Button fx:id="btnCancel" text="Annuler" onAction="#toggleEditPublication" styleClass="btn-secondary" visible="false" managed="false"/>
                        </HBox>
                    </HBox>
        
                    <Label fx:id="lblType" text="DISCUSSION" styleClass="badge-type" style="-fx-font-size: 13px;"/>
                    
                    <Separator style="-fx-opacity: 0.5;"/>

                    <StackPane fx:id="imageContainer" alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-background-radius: 15; -fx-min-height: 100;">
                        <ImageView fx:id="imgPublication" fitWidth="600.0" preserveRatio="true" smooth="true"/>
                    </StackPane>
                    
                    <Button fx:id="btnOpenPdf" text="Ouvrir le document PDF 📄" onAction="#openPdf" styleClass="btn-secondary" style="-fx-border-color: #e74c3c; -fx-text-fill: #e74c3c;" visible="false" managed="false"/>
                    
                    <Label fx:id="lblContenu" text="Contenu..." wrapText="true" styleClass="text-content" minHeight="150" alignment="TOP_LEFT"/>
                    <Button fx:id="btnTranslateMain" text="Voir la traduction 🌍" onAction="#translateMainAction" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand; -fx-underline: true; -fx-font-size: 13px; -fx-padding: 0;"/>
                    <TextArea fx:id="txtEditContenu" styleClass="text-area-custom" prefHeight="150" visible="false" managed="false"/>

                    <!-- Reaction Bar for Publication -->
                    <Separator style="-fx-opacity: 0.4;"/>
                    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                        <Button fx:id="btnLikePublication" text="👍 J'aime" onAction="#likePublication" styleClass="btn-like"/>
                        <Label fx:id="lblLikesPublication" text="0" styleClass="reaction-count"/>
                        <Button fx:id="btnDislikePublication" text="👎 Je n'aime pas" onAction="#dislikePublication" styleClass="btn-dislike"/>
                        <Label fx:id="lblDislikesPublication" text="0" styleClass="reaction-count"/>
                    </HBox>
                </VBox>
        
                <!-- Comments Section -->
                <VBox spacing="15" VBox.vgrow="NEVER">
                    <Label text="Commentaires" styleClass="header-title-sm"/>
                    <!-- We use minHeight here to ensure the ListView is visible in the ScrollPane -->
                    <ListView fx:id="listCommentaires" minHeight="400" styleClass="list-view-forum"/>
        
                    <!-- Add Comment Area -->
                    <VBox spacing="10" styleClass="card" style="-fx-padding: 15;">
                        <HBox spacing="10" alignment="CENTER">
                            <TextArea fx:id="txtNewComment" promptText="Apportez votre expertise..." prefHeight="60.0" HBox.hgrow="ALWAYS" styleClass="text-area-custom"/>
                            <Button fx:id="btnPostComment" text="Publier" onAction="#postComment" styleClass="btn-primary" prefHeight="60"/>
                        </HBox>
                    </VBox>
                </VBox>
        
            </VBox>
        </content>
    </ScrollPane>

</AnchorPane>
