<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="700.0" prefWidth="500.0" spacing="0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-overflow: hidden;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ChatbotController">
    <children>
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: linear-gradient(to right, #2d5a27, #1b4332); -fx-padding: 20;">
            <children>
                <Label style="-fx-font-size: 32;" text="🤖" />
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20;" text="Assistant Firmetna" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <children>
                                <Region style="-fx-background-color: #2ecc71; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8; -fx-background-radius: 4;" />
                                <Label style="-fx-text-fill: #e8f5e9; -fx-font-size: 12;" text="En ligne • IA Augmentée" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <!-- Chat Area -->
        <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f9fbf9; -fx-padding: 10;">
            <children>
                <ListView fx:id="chatListView" styleClass="chatbot-list-view" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" />
            </children>
        </VBox>

        <!-- Input Area -->
        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #eee; -fx-border-width: 1 0 0 0;">
            <children>
                <HBox spacing="12.0" alignment="CENTER">
                    <children>
                        <TextField fx:id="inputField" onAction="#handleSend" prefHeight="50.0" promptText="Posez votre question à Firmetna..." style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-padding: 0 20; -fx-background-color: #f1f3f1; -fx-border-color: #e0e0e0; -fx-font-size: 14;" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleSend" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 25; -fx-cursor: hand; -fx-font-size: 18;" text="➤" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
