<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="400.0" spacing="10.0" style="-fx-background-color: #f4f6f8; -fx-padding: 15;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ChatbotController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2d5a27; -fx-padding: 15; -fx-background-radius: 10;">
            <children>
                <Label style="-fx-font-size: 24;" text="🤖" />
                <VBox>
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="Assistant Firmetna" />
                        <Label style="-fx-text-fill: #e8f5e9; -fx-font-size: 11;" text="Propulsé par Hugging Face" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <ListView fx:id="chatListView" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS" />
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <TextField fx:id="inputField" onAction="#handleSend" prefHeight="40.0" promptText="Posez votre question..." style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 0 15; -fx-background-color: white; -fx-border-color: #ced6e0;" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleSend" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand;" text="➤" />
            </children>
        </HBox>
    </children>
</VBox>
