<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProductMarketplaceController">
    <children>
        <!-- Background Layer -->
        <VBox styleClass="front-root-bg" />

        <!-- Main Content Overlay -->
        <VBox spacing="0">
            <children>
                <!-- NAVIGATION BAR (Consistent with Front/Profile) -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        
                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleBack" styleClass="nav-item" text="🏠 ACCUEIL" />
                                <MenuButton styleClass="nav-item-active" text="📦 PRODUITS">
                                    <items>
                                        <MenuItem onAction="#handleBack" text="Tous les produits" />
                                    </items>
                                </MenuButton>
                                <Button onAction="#handleEvenements" styleClass="nav-item" text="📅 ÉVÉNEMENTS" />
                                <Button onAction="#handleForum" styleClass="nav-item" text="💬 FORUM" />
                                <Button onAction="#handleDons" styleClass="nav-item" text="❤ DONS" />
                                <Button onAction="#handlePartenariats" styleClass="nav-item" text="🤝 PARTENARIATS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="10">
                            <children>
                                <Label fx:id="roleInfoLabel" style="-fx-text-fill: white; -fx-font-size: 12;" />
                                <Button onAction="#handlePanier" styleClass="nav-profile-btn" text="🛒 Panier">
                                    <graphic>
                                        <Label fx:id="panierCountLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                    </graphic>
                                </Button>
                                <MenuButton styleClass="nav-profile-btn" text="Profil">
                                    <items>
                                        <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                        <SeparatorMenuItem />
                                        <MenuItem onAction="#handleLogout" style="-fx-text-fill: #e74c3c;" text="Deconnexion" />
                                    </items>
                                </MenuButton>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Market Header Section -->
                <VBox spacing="15" style="-fx-padding: 40 50 20 50;">
                    <children>
                        <HBox alignment="BOTTOM_LEFT" spacing="20">
                            <children>
                                <VBox spacing="5">
                                    <children>
                                        <Label text="Marketplace Produits" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                        <Label text="Découvrez les meilleurs produits de nos fermes locales" style="-fx-font-size: 16; -fx-text-fill: #555;" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="addProductBtn" text="+ Ajouter un produit" onAction="#handleAddProduct" 
                                        style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 12 25; -fx-font-weight: bold; -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <Separator style="-fx-opacity: 0.1;" />

                        <!-- Search and Filter Bar -->
                        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <children>
                                <TextField fx:id="searchField" promptText="Rechercher un produit..." prefWidth="350" 
                                           style="-fx-background-radius: 20; -fx-padding: 10 15; -fx-border-color: #eee; -fx-border-radius: 20;" />
                                <ComboBox fx:id="typeFilter" promptText="Tous les types" prefWidth="200"
                                          style="-fx-background-radius: 20; -fx-padding: 5 15; -fx-border-color: #eee; -fx-border-radius: 20;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER" spacing="10">
                                    <children>
                                        <Button fx:id="prevPageBtn" text="◀" onAction="#handlePrevPage" styleClass="marketplace-button-secondary" />
                                        <Label fx:id="pageInfoLabel" text="Page 1 / 1" style="-fx-font-weight: bold; -fx-text-fill: #2d5a27;" />
                                        <Button fx:id="nextPageBtn" text="▶" onAction="#handleNextPage" styleClass="marketplace-button-secondary" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Products Grid Section -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox alignment="TOP_CENTER" style="-fx-padding: 0 50 50 50;">
                            <children>
                                <TilePane fx:id="productsPane" hgap="25" vgap="25" prefColumns="3" alignment="TOP_CENTER" />
                                <VBox fx:id="emptyBox" alignment="CENTER" spacing="20" visible="false" managed="false" style="-fx-padding: 100 0;">
                                    <children>
                                        <Label text="🔍" style="-fx-font-size: 60;" />
                                        <Label fx:id="emptyLabel" text="Aucun produit trouvé." style="-fx-font-size: 20; -fx-text-fill: #888;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
        <!-- FLOAT BUTTON CHATBOT -->
        <AnchorPane pickOnBounds="false">
            <children>
                <Button onAction="#handleOpenChatbot" styleClass="chatbot-float-btn" text="🤖" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0" />
            </children>
        </AnchorPane>
    </children>
</StackPane>
