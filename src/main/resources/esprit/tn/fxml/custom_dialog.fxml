<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefWidth="500.0" style="-fx-background-color: transparent;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CustomDialogController">
    <children>
        <VBox alignment="CENTER" spacing="20.0" styleClass="dialog-card" maxWidth="450">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="35.0" />
            </padding>
            <children>
                <!-- TOP ICON SECTION -->
                <StackPane fx:id="iconContainer">
                    <children>
                        <Circle fx:id="iconBg" fill="#27ae60" radius="35.0" />
                        <Label fx:id="iconLabel" style="-fx-font-size: 35; -fx-text-fill: white;" text="✅" />
                    </children>
                </StackPane>

                <!-- TEXT SECTION -->
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label fx:id="titleLabel" styleClass="dialog-title" text="Titre" textAlignment="CENTER" wrapText="true" />
                        <Label fx:id="messageLabel" styleClass="dialog-message" text="Message." textAlignment="CENTER" wrapText="true" />
                    </children>
                </VBox>

                <!-- ACTIONS SECTION -->
                <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button fx:id="cancelBtn" onAction="#handleCancel" styleClass="dialog-btn-secondary" text="Annuler" visible="false" managed="false" />
                        <Button fx:id="actionBtn" minWidth="120.0" onAction="#handleAction" styleClass="dialog-btn-primary" text="OK" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
