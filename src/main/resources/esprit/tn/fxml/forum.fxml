<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ForumController">
    <children>
        <!-- Background Layer -->
        <VBox styleClass="front-root-bg" />

        <!-- Main Content Overlay -->
        <VBox spacing="20">
            <children>
                <!-- NAVIGATION BAR (Shared with Profile/Front) -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#returnToHome" styleClass="nav-item" text="🏠 Accueil" />
                                <Button styleClass="nav-item" text="📦 Produits" />
                                <Button styleClass="nav-item" text="📅 Événements" />
                                <Button styleClass="nav-item-active" text="💬 Forum" />
                                <Button styleClass="nav-item" text="❤ Dons" />
                                <Button styleClass="nav-item" text="🤝 Partenariats" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#returnToHome" styleClass="nav-item" text="Retour" />
                    </children>
                </HBox>

                <!-- Centered Forum Card -->
                <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="30.0" top="20.0" />
                    </padding>
                    <children>
                        <VBox maxWidth="1000" spacing="25" styleClass="profile-card-modern" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                            </padding>
                            <children>
                                <!-- Header Section -->
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <children>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2d5a27;" text="Communauté et Forum" />
                                                <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;" text="Échangez avec d'autres passionnés de l'agriculture" />
                                            </children>
                                        </VBox>
                                        <Button onAction="#switchToAddPublication" prefHeight="45" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 0 20; -fx-cursor: hand;" text="+ Nouvelle Publication" />
                                    </children>
                                </HBox>

                                <Separator style="-fx-opacity: 0.1;" />

                                <!-- Search and Filter Bar -->
                                <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 12;">
                                    <children>
                                        <TextField fx:id="searchField" prefHeight="40" promptText="Rechercher une publication..." styleClass="form-field" HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="comboFilter" prefHeight="40" prefWidth="180" styleClass="form-field" />
                                    </children>
                                </HBox>

                                <!-- List Content -->
                                <ListView fx:id="listPublications" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #eee;" VBox.vgrow="ALWAYS" />

                                <!-- Footer Actions -->
                                <HBox alignment="CENTER_RIGHT" spacing="15">
                                    <children>
                                        <Button onAction="#deletePublicationAction" prefHeight="40" style="-fx-background-color: transparent; -fx-border-color: #e74c3c; -fx-border-radius: 8; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-padding: 0 20; -fx-cursor: hand;" text="Supprimer" />
                                        <Button onAction="#viewPublicationAction" prefHeight="45" prefWidth="200" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="Ouvrir la Publication" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>