<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ForumController"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../css/forum.css" styleClass="main-bg">

    <VBox spacing="25" AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="30"
          AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50">

        <!-- Enhanced Header Area -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Button text="← Retour" onAction="#returnToHome" styleClass="btn-secondary"/>
            <VBox>
                <Label text="Communauté Firmetna" styleClass="header-title"/>
                <Label text="Partagez votre passion pour l'agriculture" styleClass="text-muted"/>
            </VBox>
        </HBox>

        <!-- Search & Filter Bar -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 15;">
            <TextField fx:id="searchField" promptText="Rechercher une publication..." HBox.hgrow="ALWAYS" styleClass="search-box"/>
            <ComboBox fx:id="comboFilter" prefWidth="180.0" styleClass="combo-box"/>
            <Button text="+ Nouvelle Publication" onAction="#switchToAddPublication" styleClass="btn-primary"/>
        </HBox>

        <!-- Main Content Area -->
        <ListView fx:id="listPublications" VBox.vgrow="ALWAYS" styleClass="list-view-forum"/>

        <!-- Bottom Actions -->
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Supprimer" onAction="#deletePublicationAction" styleClass="btn-danger"/>
        </HBox>

    </VBox>

</AnchorPane>
