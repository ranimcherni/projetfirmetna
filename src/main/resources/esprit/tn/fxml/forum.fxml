<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ForumController"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../css/forum.css" styleClass="main-bg">

    <VBox spacing="20" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40">

        <!-- Header Controls -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button text="Retour" onAction="#returnToHome" styleClass="btn-secondary"/>
            <Label text="Communauté et Forum" styleClass="header-title"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Rechercher une publication..." HBox.hgrow="ALWAYS" prefWidth="400.0" styleClass="search-box"/>
            <ComboBox fx:id="comboFilter" prefWidth="150.0" styleClass="combo-box"/>
            <Button text="Nouvelle Publication" onAction="#switchToAddPublication" styleClass="btn-primary"/>
        </HBox>

        <!-- List Content -->
        <ListView fx:id="listPublications" VBox.vgrow="ALWAYS" styleClass="list-view-forum"/>

        <!-- Actions -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Supprimer" onAction="#deletePublicationAction" styleClass="btn-danger"/>
            <Button text="Ouvrir la Publication" onAction="#viewPublicationAction" styleClass="btn-primary"/>
        </HBox>

    </VBox>

</AnchorPane>
