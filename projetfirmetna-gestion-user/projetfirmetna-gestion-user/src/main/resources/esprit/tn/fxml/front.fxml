<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.FrontController">
    <children>
        <VBox styleClass="front-root-bg" />
        <VBox mouseTransparent="true" styleClass="front-bg-overlay" />

        <VBox spacing="60">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="front-nav-bar">
                    <padding>
                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <ImageView fitHeight="35.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/logo1.png" />
                                    </image>
                                </ImageView>
                                <Label styleClass="nav-brand" text="FIRMETNA" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#handleAccueil" styleClass="nav-item" text="ACCUEIL" />
                                <MenuButton styleClass="nav-item-dropdown" text="PRODUITS">
                                    <items>
                                        <MenuItem onAction="#handleProduits" text="Tous les produits" />
                                        <MenuItem onAction="#handleProduitsVegetaux" text="Vegetaux" />
                                        <MenuItem onAction="#handleProduitsAnimaux" text="Animaux" />
                                    </items>
                                </MenuButton>
                                <Button onAction="#handleEvenements" styleClass="nav-item" text="EVENEMENTS" />
                                <Button onAction="#handleForum" styleClass="nav-item" text="FORUM" />
                                <Button onAction="#handleNotifications" styleClass="nav-item" text="NOTIFICATIONS" />
                                <Button onAction="#handleDons" styleClass="nav-item" text="DONS" />
                                <Button onAction="#handlePartenariats" styleClass="nav-item" text="PARTENARIATS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <MenuButton styleClass="nav-profile-btn" text="Profil">
                            <items>
                                <MenuItem onAction="#handleProfil" text="Mon Compte" />
                                <MenuItem onAction="#handleProduits" text="Voir les produits" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="backToAdminMenuItem" onAction="#handleBackToAdmin" text="Retourner à l'Admin" style="-fx-text-fill: #e17055;" />
                                <MenuItem onAction="#handleLogout" text="Deconnexion" style="-fx-text-fill: #e74c3c;" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <VBox alignment="CENTER_LEFT" spacing="40" VBox.vgrow="ALWAYS" style="-fx-padding: 0 150 0 150;">
                    <children>
                        <VBox spacing="15">
                            <children>
                                <Label fx:id="welcomeLabel" styleClass="greeting-label" text="Bonjour" />
                                <VBox spacing="5">
                                    <children>
                                        <Label styleClass="slogan-fr" text="Firmetna - Produits fermiers frais et de qualite" />
                                        <Label styleClass="greeting-subtitle" text="Accedez rapidement au marketplace produits." />
                                    </children>
                                </VBox>
                                <HBox spacing="15" style="-fx-padding: 20 0 0 0;">
                                    <children>
                                        <Button onAction="#handleProduits" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 15 35; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;" text="Decouvrir les Produits" />
                                        <Button onAction="#handleProduitsAnimaux" style="-fx-background-color: transparent; -fx-border-color: #2d5a27; -fx-border-radius: 30; -fx-text-fill: #2d5a27; -fx-padding: 15 35; -fx-font-size: 16; -fx-font-weight: bold; -fx-cursor: hand;" text="Produits Animaux" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox spacing="60" styleClass="stats-bar-modern" maxWidth="850">
                            <children>
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="stat-badge-value" text="2" />
                                                <Label styleClass="stat-badge-label" text="Categories Produits" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;" />
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="stat-badge-value" text="Acheter" />
                                                <Label styleClass="stat-badge-label" text="Client et Agriculteur" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <Separator orientation="VERTICAL" style="-fx-opacity: 0.2;" />
                                <HBox styleClass="stat-badge">
                                    <children>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="stat-badge-value" text="Vendre" />
                                                <Label styleClass="stat-badge-label" text="Agriculteur uniquement" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
        <!-- ================= FRONT LAYER ================= -->
        <AnchorPane pickOnBounds="false">

            <!-- CHAT WINDOW -->
            <AnchorPane fx:id="chatbotContainer"
                        prefWidth="280.0" prefHeight="350.0"
                        visible="false" managed="false"
                        layoutX="900.0"
                        layoutY="400.0"
                        style="-fx-background-color: white;
                       -fx-background-radius: 15;
                       -fx-border-radius: 15;
                       -fx-border-color: #ddd;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);">

                <children>

                    <HBox fx:id="chatHeader"
                          prefWidth="280.0"
                          prefHeight="40.0"
                          alignment="CENTER_LEFT"
                          pickOnBounds="true"
                          style="-fx-background-color: rgba(0,0,0,0.05);">

                        <children>
                            <Label text="Assistant"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;" />

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button text="✖"
                                    onAction="#toggleChatbot"
                                    mouseTransparent="true"
                                    style="-fx-background-color: transparent; -fx-text-fill: #888;" />
                        </children>

                    </HBox>

                    <!-- CHAT -->
                    <ScrollPane fx:id="chatScrollPane"
                                layoutX="15.0" layoutY="40.0"
                                prefWidth="250.0" prefHeight="220.0"
                                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                style="-fx-background: transparent; -fx-border-color: transparent;">

                        <content>
                            <VBox fx:id="chatMessages"
                                  spacing="6"
                                  style="-fx-padding: 6;" />
                        </content>
                    </ScrollPane>

                    <!-- INPUT -->
                    <HBox layoutX="10.0" layoutY="270.0" spacing="6">

                        <TextField fx:id="chatInput"
                                   promptText="Message..."
                                   prefWidth="180.0"
                                   style="-fx-background-radius: 15;
                                  -fx-border-radius: 15;
                                  -fx-border-color: #ccc;" />

                        <Button text="➤"
                                onAction="#handleSendChat"
                                style="-fx-background-color: #2e8b57;
                               -fx-text-fill: white;
                               -fx-background-radius: 15;"
                                prefWidth="60.0" />
                    </HBox>

                </children>
            </AnchorPane>

            <!-- FLOAT BUTTON -->
            <Button fx:id="chatbotToggleButton"
                    text="💬"
                    onAction="#toggleChatbot"
                    style="-fx-background-color: #2e8b57;
                   -fx-text-fill: white;
                   -fx-background-radius: 50;
                   -fx-padding: 14;
                   -fx-font-size: 16;
                   -fx-cursor: hand;"
                    layoutX="900.0"
                    layoutY="400.0"/>

        </AnchorPane>

    </children>
</StackPane>