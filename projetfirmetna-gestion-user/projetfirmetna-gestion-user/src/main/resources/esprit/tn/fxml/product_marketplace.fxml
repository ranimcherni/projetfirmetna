<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProductMarketplaceController" stylesheets="@../css/style.css">
    <top>
        <VBox spacing="12" style="-fx-background-color: #ffffff; -fx-padding: 20 30 18 30; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="marketplace-topbar">
                    <children>
                        <Button text="← Retour" onAction="#handleBack" styleClass="marketplace-button marketplace-button-secondary" />
                        <VBox spacing="4">
                            <Label text="Marketplace Produits" styleClass="dashboard-title" />
                            <Label text="Parcourez tous les produits fermiers disponibles." styleClass="dashboard-subtitle" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="roleInfoLabel" style="-fx-font-size: 13; -fx-text-fill: #2d3436; -fx-font-weight: bold;" />
                        <Button text="Panier" onAction="#handlePanier" styleClass="marketplace-button marketplace-button-primary" />
                        <Label fx:id="panierCountLabel" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="marketplace-filter-bar">
                    <children>
                        <TextField fx:id="searchField" promptText="Rechercher un produit..." styleClass="marketplace-search-field" />
                        <ComboBox fx:id="typeFilter" promptText="Tous les types" styleClass="marketplace-combo-filter" prefWidth="180" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addProductBtn" text="Ajouter un produit" onAction="#handleAddProduct" styleClass="marketplace-button marketplace-button-primary" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="marketplace-pagebar">
                    <children>
                        <Label fx:id="pageInfoLabel" text="Page 1 / 1" style="-fx-font-size: 13; -fx-text-fill: #636e72;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="prevPageBtn" text="← Précédent" onAction="#handlePrevPage" styleClass="marketplace-button marketplace-button-secondary" />
                        <Button fx:id="nextPageBtn" text="Suivant →" onAction="#handleNextPage" styleClass="marketplace-button marketplace-button-secondary" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 0 30 30 30;" hbarPolicy="NEVER">
            <content>
                <VBox spacing="18" style="-fx-padding: 20 0 30 0;">
                    <children>
                        <TilePane fx:id="productsPane" hgap="18" vgap="18" prefColumns="3" TilePane.alignment="TOP_LEFT" />
                        <Label fx:id="emptyLabel" text="Aucun produit trouvé." style="-fx-text-fill: #636e72; -fx-font-size: 16;" visible="false" managed="false" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
