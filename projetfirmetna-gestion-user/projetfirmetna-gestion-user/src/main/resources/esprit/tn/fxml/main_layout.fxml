<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME"
            prefHeight="400.0" prefWidth="600.0">
    <!-- Chatbot container (WebView) -->
    <children>
        <AnchorPane fx:id="chatbotContainer" prefWidth="350.0" prefHeight="600.0" layoutX="10.0" layoutY="10.0">
            <children>
                <WebView fx:id="chatbotWebView" prefWidth="350.0" prefHeight="600.0" />
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
