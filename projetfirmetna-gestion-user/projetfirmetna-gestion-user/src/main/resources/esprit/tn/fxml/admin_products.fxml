<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminProductsController" stylesheets="@../css/style.css">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox>
                    <Label text="Gestion Produits" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                    <Label text="Ajoutez, modifiez et supprimez les produits animaux et vegetaux." style="-fx-text-fill: #636e72; -fx-font-size: 13;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleAddProduct" text="+ Ajouter un produit" styleClass="admin-btn-primary" />
            </children>
        </HBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <children>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Total Produits" styleClass="admin-stat-label" />
                    <Label fx:id="totalProductsLabel" text="0" styleClass="admin-stat-value" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Produits Animaux" styleClass="admin-stat-label" />
                    <Label fx:id="animauxLabel" text="0" styleClass="admin-stat-value" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Produits Vegetaux" styleClass="admin-stat-label" />
                    <Label fx:id="vegetauxLabel" text="0" styleClass="admin-stat-value" />
                </VBox>
            </children>
        </HBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <children>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Produits Bio" styleClass="admin-stat-label" />
                    <Label fx:id="bioProductsLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #6c5ce7;" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Stock Total" styleClass="admin-stat-label" />
                    <Label fx:id="totalStockLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #00b894;" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Prix Moyen" styleClass="admin-stat-label" />
                    <Label fx:id="averagePriceLabel" text="0 TND" styleClass="admin-stat-value" style="-fx-text-fill: #0984e3;" />
                </VBox>
                <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Stock Faible" styleClass="admin-stat-label" />
                    <Label fx:id="lowStockLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #d63031;" />
                </VBox>
            </children>
        </HBox>

        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="admin-filter-bar">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <children>
                <TextField fx:id="searchField" prefWidth="550" prefHeight="45" promptText="Rechercher un produit..." styleClass="admin-search-field" />
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="typeFilter" prefWidth="220" prefHeight="45" styleClass="admin-combo-filter" />
            </children>
        </HBox>

        <TableView fx:id="produitTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60" />
                <TableColumn fx:id="imageCol" text="Image" prefWidth="90" />
                <TableColumn fx:id="nomCol" text="Nom" prefWidth="220" />
                <TableColumn fx:id="typeCol" text="Type" prefWidth="120" />
                <TableColumn fx:id="prixCol" text="Prix" prefWidth="100" />
                <TableColumn fx:id="uniteCol" text="Unite" prefWidth="100" />
                <TableColumn fx:id="stockCol" text="Stock" prefWidth="90" />
                <TableColumn fx:id="bioCol" text="Bio" prefWidth="100" />
                <TableColumn fx:id="badgeCol" text="Badge" prefWidth="120" />
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="180" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
